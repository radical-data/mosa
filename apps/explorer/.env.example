# Preferred connection string. Required in production (Coolify runtime secret).
# DATABASE_URL=postgresql://explorer_runtime_production:PASSWORD@db.example.com:5432/postgres

# Supabase CA certificate. Required in production (Coolify multiline secret).
# DATABASE_SSL_CA=

# Optional pool and statement timeout overrides (defaults: 5 and 5000).
# DATABASE_POOL_SIZE=5
# DATABASE_STATEMENT_TIMEOUT_MS=5000

# Required in production. Coolify and Docker HEALTHCHECK send this as X-Health-Token.
# HEALTHCHECK_TOKEN=

# Deprecated local-development alias. Prefer DATABASE_URL.
# Outside production, only loopback hosts are accepted; defaults to local Supabase.
LOCAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Private source capture; all optional until enabled. Use a dedicated capture_writer login.
CAPTURE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
RESEARCH_ORIGIN=http://localhost:4321

# Server-only Storage service key. Never a browser/build variable.
# SOURCE_STORAGE_URL defaults to SUPABASE_URL; bucket: research-sources (private).
SOURCE_STORAGE_KEY=

# Separate worker process only; grant capture_worker, never capture_writer.
RESEARCH_WORKER_DATABASE_URL=
