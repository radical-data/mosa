---
import Layout from "../../../layouts/Layout.astro";
import { boundedForm,researchTransaction } from "../../../lib/capture/access";
import { CaptureError,uuid } from "../../../lib/capture/model";
import { controlLead,type Progress } from "../../../lib/sources/discovery";
import type { Job } from "../../../lib/sources/jobs";

const id=Astro.params.id??"";
if(!uuid.test(id)) throw new CaptureError("Lead not found.");
let error="";
if(Astro.request.method === "POST") {
 try {
  const form=await boundedForm(Astro.request);
  await researchTransaction(Astro.locals.researcher,c=>controlLead(c,id,String(form.get("action")),String(form.get("url")??"")));
  return Astro.redirect(`/research/leads/${id}`,303);
 } catch(e) {error=e instanceof CaptureError?e.message:"This change could not be saved.";}
}
const job=await researchTransaction(Astro.locals.researcher,async c=>(await c.query<Job>("select * from capture.job where id=$1 and kind='discover'",[id])).rows[0]);
if(!job) throw new CaptureError("Lead not found.");
const p=job.result as Progress;
const active=["queued","running"].includes(job.status);
---
<Layout title="Research lead">
 <p><a href="/research/leads">Research leads</a></p>
 <h1>{String(job.input.institution)}</h1><p>{String(job.input.description)}</p>
 {error && <p role="alert">{error}</p>}
 <p>Status: {job.status} · Step: {p.stage}</p>
 {job.error && <p role="alert">{job.error}</p>}
 {p.stoppingReason && <p>Outcome: {p.stoppingReason.replaceAll("_"," ")}</p>}
 {p.reason && <p>{p.reason}</p>}
 <p>Requests reserved: {job.requests_used}/{String(job.input.maxRequests)} · AI tokens reserved: {job.tokens_reserved}/{String(job.input.maxTokens)}</p>
 <p><a href={Astro.url.pathname}>Refresh progress</a></p>
 {p.sourceId && <p><a href={`/research/sources/${p.sourceId}`}>Inspect or prepare the saved source manually</a></p>}
 {p.draftId && <p><a href={`/research/${p.draftId}`}>Review the prepared record</a></p>}
 <form method="post">
  {active ? <button type="submit" name="action" value="pause">Pause and take over</button> : !p.stoppingReason && <button type="submit" name="action" value="resume">Resume discovery</button>}
 </form>
 <p>Pausing lets the current bounded operation finish, then prevents new work. Human preparation and review use the same saved sources and drafts.</p>
 {!active && <form method="post" class="panel">
  <label>Catalogue URL selected through your own research<input type="url" name="url" required/></label>
  <p>Continue from this source within the remaining allowance. Earlier searches and decisions remain available.</p>
  <button type="submit" name="action" value="choose">Continue with my selected source</button>
 </form>}
 {(p.searches??[]).map(s=><section><h2>Search: {s.query}</h2><ul>{s.results.map(r=><li><a href={r.url} rel="noreferrer">{r.title}</a><p>{r.description}</p></li>)}</ul></section>)}
 <details><summary>Discovery decisions</summary><pre>{JSON.stringify(p.decisions??[],null,2)}</pre></details>
</Layout>
<style>pre{white-space:pre-wrap;overflow-wrap:anywhere}.panel{margin-top:1rem;display:grid;gap:1rem}</style>
