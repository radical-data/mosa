---
import Layout from "../../layouts/Layout.astro";
import { boundedForm, researchTransaction } from "../../lib/capture/access";
import {
  CaptureError,
  type Content,
  readContent,
} from "../../lib/capture/model";
import {
  agentChoices,
  changeDraft,
  getDraft,
  identityMatches,
} from "../../lib/capture/store";

const actor = Astro.locals.researcher;
const id = Astro.params.id ?? "";
let error = "";
let submitted: Content | undefined;
if (Astro.request.method === "POST") {
  const form = await boundedForm(Astro.request);
  try {
    const action = String(form.get("action"));
    await researchTransaction(actor, async (client) => {
      const previous = await getDraft(client, actor, id);
      if (["save", "review", "defer"].includes(action) && form.has("url"))
        submitted = readContent(form, previous.content);
      return changeDraft(
        client,
        actor,
        id,
        Number(form.get("revision")),
        action,
        submitted,
        String(form.get("identity")),
      );
    });
    return Astro.redirect(`/research/${id}`, 303);
  } catch (e) {
    error =
      e instanceof CaptureError
        ? e.message
        : "The change could not be saved. Please try again. No partial import was committed.";
  }
}
const { draft, matches, agents } = await researchTransaction(
  actor,
  async (client) => {
    const draft = await getDraft(client, actor, id);
    return {
      draft,
      matches:
        draft.status === "review"
          ? await identityMatches(client, draft.content)
          : [],
      agents: await agentChoices(client),
    };
  },
);
const c = submitted ?? draft.content;
const relationships = [
  ["supports", "Supports the statement"],
  ["qualifies", "Qualifies the statement"],
  ["contradicts", "Contradicts the statement"],
  ["mentions", "Mentions it"],
  ["provides_context", "Provides context"],
];
---

<Layout title={c.label || c.name || "Review source"}>
  <p class="breadcrumb"><a href="/research">Your drafts</a></p>
  <h1>{c.label || c.name || "Record what the source says"}</h1>
  <p><span class="badge">{draft.status}</span> · Revision {draft.revision}</p>
  {
    error && (
      <p class="notice" role="alert">
        {error}
      </p>
    )
  }
  {
    draft.status === "accepted" ? (
      <section class="panel">
        <h2>Saved to the research collection</h2>
        <p>
          <a href={`/entities/${draft.item_id}`}>Open the research record</a>
        </p>
        <p>
          This acceptance does not publish anything. Ask a maintainer to review
          the selected fields for the website.
        </p>
      </section>
    ) : draft.status === "deleted" ? (
      <p>
        This draft has been removed from your workspace. No research record was
        changed.
      </p>
    ) : (
      <>
        {draft.status === "review" && !error && (
          <section class="panel" aria-label="Review proposed record">
            <h2>Review the proposed record</h2>
            <p>
              <a href={c.url} target="_blank" rel="noreferrer">
                Open the source catalogue
              </a>{" "}
              · Source recorded{" "}
              {new Date(c.checkedAt).toLocaleDateString("en-GB")}
            </p>
            <dl class="metadata">
              <div>
                <dt>Name</dt>
                <dd>{c.name}</dd>
                <dd>
                  {c.nameLocator}: <q>{c.nameExcerpt}</q> ({c.nameRelationship})
                </dd>
              </div>
              <div>
                <dt>Reported holder</dt>
                <dd>{c.holder}</dd>
                <dd>
                  {c.holderLocator}: <q>{c.holderExcerpt}</q> (
                  {c.holderRelationship})
                </dd>
              </div>
              <div>
                <dt>Catalogue identifier</dt>
                <dd>
                  {c.namespace}: {c.identifier}
                </dd>
              </div>
              <div>
                <dt>Statements attributed to</dt>
                <dd>
                  {c.speakerMode === "holder"
                    ? c.holder
                    : c.speakerMode === "other"
                      ? c.speaker
                      : "Unknown"}
                </dd>
              </div>
            </dl>
            <h3>Confirm the object identity</h3>
            <p>
              Names do not establish identity. These matches use the exact
              identifier or source URL.
            </p>
            <form method="post">
              <input type="hidden" name="revision" value={draft.revision} />
              {matches.length ? (
                matches.map((m) => (
                  <label class="identity-choice">
                    <input type="radio" name="identity" value={m.id} required />
                    <span>
                      <strong>{m.label}</strong> — {m.reason}
                      <br />
                      {m.identifier}
                      {m.holder && ` · Reported holder: ${m.holder}`}
                    </span>
                  </label>
                ))
              ) : (
                <label class="identity-choice">
                  <input type="radio" name="identity" value="new" required />
                  <span>
                    I have checked this source and want to create a new object.
                  </span>
                </label>
              )}
              <div class="actions">
                <button type="submit" name="action" value="accept">
                  Accept into research collection
                </button>
                <button
                  type="submit"
                  name="action"
                  value="defer"
                  formnovalidate
                >
                  Defer identity decision
                </button>
                <button
                  type="submit"
                  name="action"
                  value="reject"
                  formnovalidate
                >
                  Reject proposal
                </button>
              </div>
            </form>
          </section>
        )}
        <h2>
          {draft.status === "review"
            ? "Edit the proposal"
            : "Source and statements"}
        </h2>
        <p>
          Keep wording and names as written in the source. A reported holder is
          not a statement of ownership. Unknown attribution is allowed in
          research, but cannot yet be published.
        </p>
        <form method="post" class="panel">
          <input type="hidden" name="revision" value={draft.revision} />
          <fieldset>
            <legend>Source</legend>
            <label>
              Catalogue URL
              <input type="url" name="url" required value={c.url} />
            </label>
            <label>
              Source checked at (UTC)
              <input
                type="datetime-local"
                name="checkedAt"
                required
                value={c.checkedAt.slice(0, 16)}
              />
            </label>
            <label>
              Working label (private)
              <input name="label" value={c.label} maxlength="200" />
            </label>
            <label>
              Research note (private)
              <textarea name="note" maxlength="4000">
                {c.note}
              </textarea>
            </label>
            <label>
              Catalogue or institution code
              <input
                name="namespace"
                value={c.namespace}
                placeholder="For example: british-museum"
              />
            </label>
            <label>
              Catalogue identifier
              <input name="identifier" value={c.identifier} />
            </label>
          </fieldset>
          <fieldset>
            <legend>Object name</legend>
            <label>
              Name as written
              <input name="name" value={c.name} />
            </label>
            <label>
              Where in the source?
              <input
                name="nameLocator"
                value={c.nameLocator}
                placeholder="For example: title field"
              />
            </label>
            <label>
              Supporting quotation
              <textarea name="nameExcerpt" maxlength="4000">
                {c.nameExcerpt}
              </textarea>
            </label>
            <label>
              How does the source relate to this name?
              <select name="nameRelationship">
                {relationships.map(([value, label]) => (
                  <option value={value} selected={value === c.nameRelationship}>
                    {label}
                  </option>
                ))}
              </select>
            </label>
          </fieldset>
          <fieldset>
            <legend>Reported holding institution</legend>
            <label>
              Institution name as written
              <input name="holder" value={c.holder} />
            </label>
            <label>
              Confirm the institution identity
              <select name="holderIdentity">
                <option value="new" selected={c.holderIdentity === "new"}>
                  Create a separate institution
                </option>
                {agents.map((a) => (
                  <option value={a.id} selected={c.holderIdentity === a.id}>
                    {a.label}
                  </option>
                ))}
              </select>
            </label>
            <p class="muted">
              Choose an existing institution only when you have checked it is
              the same one. Matching names never merge records automatically.
            </p>
            <label>
              Where in the source?
              <input name="holderLocator" value={c.holderLocator} />
            </label>
            <label>
              Quotation supporting the holder and its name
              <textarea name="holderExcerpt" maxlength="4000">
                {c.holderExcerpt}
              </textarea>
            </label>
            <label>
              How does the source relate to this holder?
              <select name="holderRelationship">
                {relationships.map(([value, label]) => (
                  <option
                    value={value}
                    selected={value === c.holderRelationship}
                  >
                    {label}
                  </option>
                ))}
              </select>
            </label>
          </fieldset>
          <fieldset>
            <legend>Who makes these statements?</legend>
            <label>
              Attribution
              <select name="speakerMode">
                <option value="unknown" selected={c.speakerMode === "unknown"}>
                  Unknown
                </option>
                <option value="holder" selected={c.speakerMode === "holder"}>
                  The holding institution, publishing its own catalogue
                </option>
                <option value="other" selected={c.speakerMode === "other"}>
                  Another institution or person
                </option>
              </select>
            </label>
            <p class="muted">
              Complete these fields only when you selected another institution
              or person.
            </p>
            <label>
              Asserting institution or person
              <input name="speaker" value={c.speaker} />
            </label>
            <label>
              Confirm their identity
              <select name="speakerIdentity">
                <option value="new" selected={c.speakerIdentity === "new"}>
                  Create a separate record
                </option>
                {agents.map((a) => (
                  <option value={a.id} selected={c.speakerIdentity === a.id}>
                    {a.label}
                  </option>
                ))}
              </select>
            </label>
            <label>
              Where is their name given?
              <input name="speakerLocator" value={c.speakerLocator} />
            </label>
            <label>
              Supporting quotation
              <textarea name="speakerExcerpt" maxlength="4000">
                {c.speakerExcerpt}
              </textarea>
            </label>
          </fieldset>
          <div class="actions">
            <button type="submit" name="action" value="save">
              Save draft
            </button>
            <button type="submit" name="action" value="review">
              Save and review
            </button>
            <button type="submit" name="action" value="defer" formnovalidate>
              Defer
            </button>
            <button type="submit" name="action" value="delete" formnovalidate>
              Remove draft
            </button>
          </div>
        </form>
      </>
    )
  }
</Layout>
<style>
  form {
    display: grid;
    gap: 1rem;
  }
  fieldset {
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    display: grid;
    gap: 1rem;
    padding: 1rem;
    margin-block: 0.5rem;
  }
  legend {
    font-weight: 700;
  }
  textarea {
    font: inherit;
    padding: 0.7rem;
    min-height: 6rem;
    resize: vertical;
    border: 1px solid #aaa497;
    border-radius: 0.45rem;
  }
  .actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .identity-choice {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .identity-choice input {
    min-height: auto;
  }
  .metadata dd {
    white-space: pre-wrap;
  }
</style>
