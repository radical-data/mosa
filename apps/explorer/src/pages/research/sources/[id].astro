---
import Layout from "../../../layouts/Layout.astro";
import { boundedForm, researchTransaction } from "../../../lib/capture/access";
import { CaptureError, type Content, newRequestId, normaliseContent } from "../../../lib/capture/model";
import { createDraft } from "../../../lib/capture/store";
import { enqueueCapture, type Job } from "../../../lib/sources/jobs";
import { enqueuePreparation } from "../../../lib/sources/preparation";
import { getSource, type SourceVersion } from "../../../lib/sources/store";

const id = Astro.params.id ?? "";
let error = "";
if (Astro.request.method === "POST") {
 try {
  const form = await boundedForm(Astro.request);
  const draft = await researchTransaction(Astro.locals.researcher, async c => {
    const source = await getSource(c, id);
    if (form.get("action") === "ai") await enqueuePreparation(c,Astro.locals.researcher,String(form.get("requestId")),String(form.get("version")),form.get("consent") === "yes");
    if (form.get("action") === "capture" && source.original_url) await enqueueCapture(c,Astro.locals.researcher,String(form.get("requestId")),source.original_url);
    if (form.get("action") === "retry") await c.query("update capture.job set status='queued',attempts=0,error=null where id=$1 and source_id=$2 and status='failed'",[String(form.get("job")),id]);
    if (form.get("action") === "prepare") {
      const version = (await c.query<SourceVersion>("select * from capture.source_version where id=$1 and source_id=$2 and state='ready'", [String(form.get("version")), id])).rows[0];
      if (!version) throw new Error("Source version unavailable");
      return createDraft(c, Astro.locals.researcher, String(form.get("requestId")), normaliseContent({sourceVersion: version.id, label: source.citation.slice(0,200), holderStatus: "unknown"} as Content));
    }
    if (form.get("action") === "hide") await c.query("update capture.source set hidden=true where id=$1", [id]);
  });
  return Astro.redirect(draft ? `/research/${draft.id}` : `/research/sources/${id}`, 303);
 } catch(e) {error=e instanceof CaptureError?e.message:"The request could not be saved. Saved work is retained.";}
}
const { source, versions, jobs } = await researchTransaction(Astro.locals.researcher, async c => ({
  source: await getSource(c, id),
  jobs: (await c.query<Job>("select * from capture.job where source_id=$1 order by created_at desc",[id])).rows,
  versions: (await c.query<SourceVersion>("select * from capture.source_version where source_id=$1 order by created_at desc", [id])).rows,
}));
---
<Layout title={source.citation}>
  <p><a href="/research/sources">Your sources</a></p>
  <h1>{source.citation}</h1>
  {error && <p role="alert">{error}</p>}
  {source.author && <p>Author or compiler: {source.author}</p>}
  {source.document_date && <p>Document date: {source.document_date}</p>}
  <p>Private original. Publication and research acceptance are separate decisions.</p>
  {source.original_url && <form method="post"><p><a href={source.original_url} rel="noreferrer">Original catalogue</a></p><input type="hidden" name="requestId" value={newRequestId()} /><button type="submit" name="action" value="capture">Capture another version</button></form>}
  {jobs.map(job => <section class="panel"><p>{job.kind === "prepare" ? "AI preparation" : "Capture"}: {job.status}</p>{typeof job.result.draftId === "string" && <p><a href={`/research/${job.result.draftId}`}>Review prepared record</a></p>}{job.result.stoppingReason === "ambiguous" && <p>Ambiguous source: prepare a selected object manually.</p>}{job.error && <p role="alert">{job.error}</p>}{job.status === "failed" && <form method="post"><input type="hidden" name="job" value={job.id}/><button type="submit" name="action" value="retry">Retry operation</button></form>}</section>)}
  <p><a href={Astro.url.pathname}>Refresh progress</a></p>
  {versions.map(v => <section class="panel">
    <h2>{v.filename}</h2><p>{v.state === "ready" ? "Preserved" : "Upload unfinished"} · {v.byte_count.toLocaleString("en-GB")} bytes</p>
    <p>Uploaded: {new Date(v.created_at).toISOString()}</p>
    {v.state === "ready" ? <p><a href={`/research/sources/files/${v.id}`}>Open original document</a></p> : <p><a href={`/research/sources?retry=${source.id}`}>Retry this upload</a></p>}
    {v.state === "ready" && <form method="post">
      <input type="hidden" name="requestId" value={newRequestId()} />
      <input type="hidden" name="version" value={v.id} />
      <button type="submit" name="action" value="prepare">Prepare an object record</button>
    </form>}
    {v.state === "ready" && v.readable_text && <form method="post">
      <input type="hidden" name="requestId" value={newRequestId()} /><input type="hidden" name="version" value={v.id} />
      <label><input type="checkbox" name="consent" value="yes" required /> I have permission to send this saved source to the external model for preparation.</label>
      <button type="submit" name="action" value="ai">Prepare with AI</button>
    </form>}
    {v.state === "ready" && v.readable_text && <details open><summary>Readable source copy</summary><pre class="source-text">{v.readable_text}</pre></details>}
    {v.manifest && <details><summary>Retrieval details</summary><pre>{JSON.stringify(v.manifest,null,2)}</pre></details>}
    <details><summary>Preservation checksum</summary><code>{v.sha256}</code></details>
  </section>)}
  <form method="post"><button type="submit" name="action" value="hide">Hide from my source list</button></form>
</Layout>

<style>pre {white-space:pre-wrap;overflow-wrap:anywhere;max-width:100%;}</style>
