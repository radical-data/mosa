---
import Layout from "../../layouts/Layout.astro";
import { formatSourceLabel, predicateLabel } from "../../lib/labels";
import { formatDate, literalLabel } from "../../lib/presentation";
import { type ClaimDetail, getClaim } from "../../lib/queries";
import { isUuid } from "../../lib/values";

const id = Astro.params.id ?? "";
let claim: ClaimDetail | null = null;
let loadFailed = false;

if (isUuid(id)) {
  try {
    claim = await getClaim(id);
  } catch (error) {
    loadFailed = true;
    console.error(`Unable to load claim ${id}`, error);
  }
}

if (!claim && !loadFailed) {
  Astro.response.status = 404;
}

const createdAt = claim ? formatDate(claim.createdAt) : null;
const subjectHref = claim
  ? claim.subjectType === "event"
    ? `/events/${claim.subjectId}`
    : `/entities/${claim.subjectId}`
  : "/";
const objectHref =
  claim?.objectEntityId && claim.objectEntityType === "event"
    ? `/events/${claim.objectEntityId}`
    : claim?.objectEntityId
      ? `/entities/${claim.objectEntityId}`
      : null;
---

<Layout title={claim ? predicateLabel(claim.predicate) : "Claim not found"}>
  <p class="breadcrumb">
    <a href="/">← Search</a>
    {claim && <> · <a href={subjectHref}>{claim.subjectLabel}</a></>}
  </p>

  {
    loadFailed ? (
      <div class="notice">Unable to load this claim. Check that the database is available and reload this page.</div>
    ) : !claim ? (
      <>
        <h1>Not found</h1>
        <p class="lede">No claim matches this identifier.</p>
      </>
    ) : (
      <>
        <p class="eyebrow">Claim</p>
        <h1>{predicateLabel(claim.predicate)}</h1>
        <div class="badges">
          <span class="badge">value: {claim.valueKind}</span>
          <span class="badge">status: {claim.status}</span>
        </div>

        <dl class="metadata panel">
          <div>
            <dt>Subject</dt>
            <dd><a href={subjectHref}>{claim.subjectLabel}</a></dd>
          </div>
          <div>
            <dt>Predicate</dt>
            <dd><code>{claim.predicate}</code></dd>
          </div>
          <div>
            <dt>Value</dt>
            <dd>
              {claim.valueKind === "entity" && claim.objectEntityId ? (
                <a href={objectHref ?? `/entities/${claim.objectEntityId}`}>
                  {claim.objectEntityLabel ?? claim.objectEntityId}
                </a>
              ) : (
                <span class="literal">{literalLabel(claim)}</span>
              )}
              {claim.literalLanguage && <span class="muted"> ({claim.literalLanguage})</span>}
            </dd>
          </div>
          <div>
            <dt>Asserted by</dt>
            <dd>
              {claim.assertedByAgentId ? (
                <a href={`/entities/${claim.assertedByAgentId}`}>
                  {claim.assertedByLabel ?? claim.assertedByAgentId}
                </a>
              ) : "Not recorded"}
            </dd>
          </div>
          {claim.supersedesClaimId && <div><dt>Supersedes</dt><dd><a href={`/claims/${claim.supersedesClaimId}`}>{claim.supersedesClaimId}</a></dd></div>}
          {claim.notes && <div><dt>Note</dt><dd>{claim.notes}</dd></div>}
          {createdAt && <div><dt>Created</dt><dd>{createdAt}</dd></div>}
        </dl>

        {
          claim.valueKind === "literal" && claim.literalValue !== null && (
            <>
              <h2>Literal value</h2>
              <pre class="literal-json">{JSON.stringify(claim.literalValue, null, 2)}</pre>
            </>
          )
        }

        <h2>Evidence</h2>
        {
          claim.evidence.length === 0 ? (
            <div class="empty">No evidence attached.</div>
          ) : (
            <section class="claims" aria-label="Claim evidence">
              {claim.evidence.map((evidence) => (
                <article class="claim-card">
                  <div class="claim-card__top">
                    <h3>{evidence.relationship}</h3>
                    <span class="badge">evidence</span>
                  </div>
                  <p><a href={`/entities/${evidence.sourceId}`}>{formatSourceLabel(evidence.sourceLabel)}</a></p>
                  {evidence.sourceVersionId && <p><a href={`/research/sources/files/${evidence.sourceVersionId}`}>Open cited source version (researcher access)</a></p>}
                  {evidence.locator && <p><strong>Locator:</strong> {evidence.locator}</p>}
                  {evidence.excerpt && <blockquote>{evidence.excerpt}</blockquote>}
                  {evidence.notes && (
                    <p class="muted"><strong>Note:</strong> {evidence.notes}</p>
                  )}
                </article>
              ))}
            </section>
          )
        }
      </>
    )
  }
</Layout>
