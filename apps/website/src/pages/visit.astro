---
import PageIntro from "../components/PageIntro.astro";
import { collection } from "../data/site";
import Layout from "../layouts/Layout.astro";
---
<Layout title="Visita — MoSA" description="Un patrimonio disperso: instituciones que retienen las entidades de Rapa Nui presentes en la colección de referencia.">
  <PageIntro title="Visita" image="rongorongo"><p>Un museo que comienza en Rapa Nui y se extiende por los lugares donde sus objetos y ancestros permanecen separados de su territorio. La colección permite reconocer esa distribución y volver a ponerla en relación con su origen.</p></PageIntro>
  <section class="container section editorial"><h2 class="eyebrow">Una colección dispersa</h2><div><p class="statement">El territorio de origen está presente en cada relación, aunque la distancia lo atraviese todo.</p><div class="distribution"><div class="origin"><span class="small">Territorio de origen</span><strong>Rapa Nui</strong></div><div class="destinations"><span>Europa</span><span>América del Norte</span><span>Oceanía</span></div></div><p class="small muted">Esquema de distribución de los registros de referencia. El mapa de instituciones está en preparación.</p></div></section>
  <section class="container section editorial"><h2 class="eyebrow">Instituciones en la colección</h2><div class="institution-list">{collection.map((item) => <article><div><h3>{item.institution}</h3><p>{item.location}</p></div><p>{item.name}</p></article>)}</div></section>
  <section class="container section connect-strip"><div><h2>Otra forma de acercarse.</h2><p>Conoce los encuentros y acciones públicas de MoSA.</p></div><a class="button" href="/events/">Ver eventos <span aria-hidden="true">↗</span></a></section>
</Layout>
