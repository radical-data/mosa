---
import { getCopy } from "../content/content";
import { programme } from "../data/site";
import { formatHistoricalDate } from "../i18n/format";
import type { Locale } from "../i18n/routes";

interface Props { open?: boolean; locale: Locale; }
const { open = false, locale } = Astro.props;
const copy = getCopy("programme", locale);
---
<details class="event" open={open}>
  <summary>
    <span class="event-meta"><strong>{programme.institution}</strong><time datetime={programme.date}>{formatHistoricalDate(programme.date, locale)}</time></span>
    <span class="event-title">{copy.title}</span>
    <span class="event-symbol" aria-hidden="true"></span>
  </summary>
  <div class="event-body"><p>{copy.body}</p><p class="muted small">{copy.availability}</p></div>
</details>
