{
  "name": "@mosa/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node --import tsx scripts/verify-output.ts",
    "check": "astro check",
    "preview": "astro preview",
    "validate:localisation": "node --import tsx scripts/validate-localisation.ts",
    "test": "vitest run --root ../.. apps/website/src",
    "test:output": "node --import tsx scripts/verify-output.ts",
    "test:http": "node --import tsx scripts/verify-http.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "7.0.9",
    "@mosa/public-collection": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
