{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mosa:schemas:object-dossier-packet:4",
  "title": "MoSA object dossier packet",
  "description": "A validated packet of object dossiers for the transactional importer (ADR 012). Records are referenced by symbolic local keys; canonical UUIDs are always generated by PostgreSQL and never appear in a packet.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dataset", "objects", "agents", "places", "sources", "claims"],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2, 3, 4]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version"],
      "properties": {
        "key": {
          "description": "Stable logical identifier for this packet lineage across repeated imports, for example mosa-bootstrap.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "version": {
          "description": "Human-readable packet version, for example a date or sequence number.",
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "restitutionCases": {
      "type": "array",
      "items": { "$ref": "#/$defs/restitutionCase" }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "localKey": {
      "description": "Symbolic packet-local key, for example item:hoa-hakananai-a. Keys are opaque; entity type is determined by the array a record appears in.",
      "type": "string",
      "pattern": "^\\S+(?: \\S+)*$",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "pattern": "^\\S+(?:\\s\\S+)*$",
      "minLength": 1
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": {
          "$ref": "#/$defs/localKey"
        },
        "kind": {
          "description": "Item kind, for example artefact or ancestral_remains.",
          "$ref": "#/$defs/kind"
        },
        "externalIdentifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "value"],
            "properties": {
              "namespace": {
                "description": "The assigning system or institution, for example british-museum.",
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "description": "Optional local key of the packet source establishing or displaying this identifier.",
                "$ref": "#/$defs/localKey"
              }
            }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": {
          "$ref": "#/$defs/localKey"
        },
        "kind": {
          "description": "Agent kind, for example person or organisation.",
          "$ref": "#/$defs/kind"
        }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": {
          "$ref": "#/$defs/localKey"
        },
        "kind": {
          "description": "Place kind, for example city, site or volcano.",
          "$ref": "#/$defs/kind"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind"],
      "properties": {
        "key": { "$ref": "#/$defs/localKey" },
        "kind": { "enum": ["transfer", "relocation", "unknown"] }
      }
    },
    "caseDate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "precision"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" },
        "precision": { "enum": ["day", "month", "year"] }
      }
    },
    "caseParty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "role"],
      "properties": {
        "agent": { "$ref": "#/$defs/localKey" },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "restitutionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "reference",
        "title",
        "status",
        "items",
        "parties",
        "documents",
        "actions"
      ],
      "properties": {
        "key": { "$ref": "#/$defs/localKey" },
        "reference": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "closed"] },
        "opened": { "$ref": "#/$defs/caseDate" },
        "closed": { "$ref": "#/$defs/caseDate" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/localKey" } },
        "parties": { "type": "array", "items": { "$ref": "#/$defs/caseParty" } },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "source", "role"],
            "properties": {
              "key": { "$ref": "#/$defs/localKey" },
              "source": { "$ref": "#/$defs/localKey" },
              "role": { "type": "string", "minLength": 1 }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "sequenceNumber", "kind", "description", "parties", "documents"],
            "properties": {
              "key": { "$ref": "#/$defs/localKey" },
              "sequenceNumber": { "type": "integer", "minimum": 1 },
              "kind": {
                "enum": [
                  "outreach",
                  "request",
                  "engagement",
                  "recommendation",
                  "decision",
                  "handover"
                ]
              },
              "description": { "type": "string", "minLength": 1 },
              "occurred": { "$ref": "#/$defs/caseDate" },
              "parties": { "type": "array", "items": { "$ref": "#/$defs/caseParty" } },
              "documents": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["document"],
                  "properties": {
                    "document": { "$ref": "#/$defs/localKey" },
                    "relationship": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "retrievedAt"],
      "properties": {
        "key": {
          "$ref": "#/$defs/localKey"
        },
        "kind": {
          "description": "Source kind, for example institutional_record or webpage.",
          "$ref": "#/$defs/kind"
        },
        "url": {
          "description": "Absolute HTTP or HTTPS URL of the source. Stored as entities.source.reference.",
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "retrievedAt": {
          "description": "When the source was retrieved or last checked. The importer preserves the original timestamp on reruns.",
          "type": "string",
          "format": "date-time"
        },
        "about": {
          "description": "Local keys of the packet objects this source concerns. Each entry becomes a source refers_to object claim.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/localKey"
          }
        },
        "assertedBy": {
          "description": "Optional local key of the agent asserting the derived refers_to claims.",
          "$ref": "#/$defs/localKey"
        },
        "citation": { "type": "string", "minLength": 1 },
        "publicUrl": { "type": "string", "pattern": "^https?://\\S+$" },
        "reference": {
          "type": "string",
          "pattern": "^urn:mosa:source:[0-9a-f-]{36}$"
        },
        "version": {
          "type": "string",
          "format": "uuid"
        }
      },
      "oneOf": [
        {
          "required": ["url"],
          "not": {
            "anyOf": [
              {
                "required": ["reference"]
              },
              {
                "required": ["version"]
              }
            ]
          }
        },
        {
          "required": ["reference", "version"],
          "not": {
            "required": ["url"]
          }
        }
      ]
    },
    "textLiteral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "const": "text"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "description": "Optional BCP 47 / ISO 639 language tag, for example en or rap.",
          "type": "string",
          "minLength": 2
        }
      }
    },
    "dateLiteral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "earliest", "latest", "precision", "interpretation", "verbatim"],
      "properties": {
        "type": { "const": "date_interval" },
        "earliest": { "type": "string", "minLength": 1 },
        "latest": { "type": "string", "minLength": 1 },
        "precision": { "enum": ["day", "month", "year", "century"] },
        "interpretation": {
          "enum": [
            "exact",
            "approximate",
            "approximate_range",
            "range",
            "alternatives",
            "hypothesis"
          ]
        },
        "verbatim": { "type": "string", "minLength": 1 },
        "alternatives": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "source", "relationship", "locator"],
      "properties": {
        "key": {
          "$ref": "#/$defs/localKey"
        },
        "source": {
          "description": "Local key of the packet source providing this evidence.",
          "$ref": "#/$defs/localKey"
        },
        "relationship": {
          "enum": ["supports", "contradicts", "qualifies", "mentions", "provides_context"]
        },
        "locator": {
          "description": "Where in the source the evidence sits, for example a field name, page or timestamp.",
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "description": "The relevant source wording. May be omitted only for visual sources or whole-document evidence.",
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "description": "Whether this evidence quotes an excerpt or cites the source as a whole.",
          "enum": ["excerpt", "whole_document"]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "subject", "predicate", "evidence"],
      "properties": {
        "key": {
          "$ref": "#/$defs/localKey"
        },
        "subject": {
          "$ref": "#/$defs/localKey"
        },
        "predicate": {
          "description": "Version 4 admits the implemented ontology predicates; earlier versions retain their narrower contracts.",
          "enum": [
            "has_name",
            "made_at",
            "found_at",
            "located_at",
            "held_by",
            "classified_as",
            "described_as",
            "made_of",
            "made_during",
            "refers_to",
            "depicts",
            "authored_by",
            "published_by",
            "possibly_same_as",
            "physical_remains_of",
            "moved_item",
            "moved_from",
            "moved_to",
            "moved_via",
            "carried_out_by",
            "commanded_by",
            "transferred_item",
            "transferred_to",
            "held_item",
            "holding_agent",
            "transferred_from",
            "occurred_at",
            "occurred_during"
          ]
        },
        "object": {
          "description": "Local key of the claim value entity. Exactly one of object or literal must be present.",
          "$ref": "#/$defs/localKey"
        },
        "literal": {
          "oneOf": [{ "$ref": "#/$defs/textLiteral" }, { "$ref": "#/$defs/dateLiteral" }]
        },
        "assertedBy": {
          "description": "Optional local key of the agent represented as making the assertion.",
          "$ref": "#/$defs/localKey"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/evidence"
              }
            }
          ]
        }
      },
      "oneOf": [
        {
          "required": ["object"],
          "not": {
            "required": ["literal"]
          }
        },
        {
          "required": ["literal"],
          "not": {
            "required": ["object"]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "enum": [1, 2, 3] } } },
      "then": {
        "properties": {
          "events": { "type": "array", "maxItems": 0 },
          "restitutionCases": { "type": "array", "maxItems": 0 },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "predicate": {
                  "enum": [
                    "has_name",
                    "made_at",
                    "found_at",
                    "located_at",
                    "held_by",
                    "classified_as",
                    "described_as"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "predicate": {
                  "enum": ["has_name", "made_at", "found_at", "located_at", "held_by"]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [1, 2]
          }
        }
      },
      "then": {
        "properties": {
          "sources": {
            "items": {
              "required": ["url"],
              "not": {
                "anyOf": [
                  {
                    "required": ["reference"],
                    "type": "object"
                  },
                  {
                    "required": ["version"],
                    "type": "object"
                  }
                ]
              },
              "type": "object"
            },
            "type": "array"
          }
        }
      }
    }
  ]
}
