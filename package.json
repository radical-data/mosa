{
  "name": "mosa",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "validate:collection": "node --import tsx scripts/validate-collection.ts",
    "validate:localisation": "node --import tsx scripts/validate-localisation.ts",
    "test": "vitest run",
    "test:http": "node --import tsx scripts/verify-http.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "astro": "7.0.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "2.5.4",
    "@types/node": "^24.0.0",
    "github-slugger": "^2.0.0",
    "lefthook": "^2.1.10",
    "mdast-util-from-markdown": "^2.0.3",
    "single-file-cli": "2.16.0",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
