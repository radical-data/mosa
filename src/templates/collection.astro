---
import { Image } from "astro:assets";
import CollectionNav from "../components/CollectionNav.astro";
import PageIntro from "../components/PageIntro.astro";
import { getCopy } from "../content/content";
import { collectionRecords } from "../data/site";
import { messages } from "../i18n/catalogues";
import { referenceCount } from "../i18n/messages";
import { type Locale, pagePath } from "../i18n/routes";
import Layout from "../layouts/Layout.astro";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = getCopy("collection", locale);
const collection = collectionRecords;
const t = messages(locale);
---
<Layout locale={locale} page="collection" title={copy.title} description={copy.description}>
  <PageIntro title={copy.passage03} image="mahute"><p><Fragment set:html={copy.passage06} /></p><a class="text-link" href="#more-information">{copy.passage17}</a></PageIntro>
  <section class="container section collection-section" aria-label={t.collectionExplore} data-locale={locale}>
    <CollectionNav locale={locale} active="objects" />
    <div class="collection-controls" hidden>
      <label for="collection-search">{t.collectionSearch}</label>
      <input id="collection-search" type="search" placeholder={t.collectionSearch} />
    </div>
    <p class="small muted" id="collection-count" role="status" aria-live="polite">{referenceCount(locale, { count: collection.length })}</p>
    {collection.length === 0 && <p>{t.collectionPending}</p>}
    <div class="collection-grid public-collection" id="collection-results">{collection.map((item) => <article class="collection-card" data-record-id={item.object.id} data-search-exact={item.searchExact} data-search-foldable={item.searchFoldable}>
      {item.images[0] && <Image src={item.images[0].asset} alt={item.images[0].image.alt} lang={item.images[0].source.language} widths={[360, 720]} sizes="(max-width: 48rem) 100vw, 33vw" />}
      <div class="collection-caption">
        <h2><a href={`${pagePath("collection", locale)}${item.object.id}/`}>{item.object.name}</a></h2>
        {[...new Set(item.claims.filter(({ claim }) => claim.predicate === "held_by").map(({ claim }) => claim.value))].map((holder) => <p>{t.reportedHolder} {holder}</p>)}
        {item.claims.filter(({ claim }) => claim.predicate === "catalogue_number").map(({ claim }) => <p>{t.catalogueNumber} {claim.value}</p>)}
      </div>
    </article>)}</div>
    <div class="empty-state" hidden><h2><Fragment set:html={t.noMatches} /></h2><p><Fragment set:html={t.noMatchesHelp} /></p><button class="button" type="button" id="reset-filters">{t.clearFilters}</button></div>
    <noscript><p><Fragment set:html={t.enableCollectionScript} /></p></noscript>
  </section>
  <section class="container section" id="more-information"><h2 class="eyebrow"><Fragment set:html={copy.passage12} /></h2><div class="info-grid"><article class="info-card coral"><h3><Fragment set:html={copy.passage13} /></h3><p><Fragment set:html={copy.passage14} /></p></article><article class="info-card"><h3><Fragment set:html={copy.passage15} /></h3><p><Fragment set:html={copy.passage16} /></p></article></div></section>
</Layout>

<script>
  import "../i18n/collection-client";
</script>
