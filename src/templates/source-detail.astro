---
import { Image } from "astro:assets";
import ClaimStatement from "../components/ClaimStatement.astro";
import CollectionNav from "../components/CollectionNav.astro";
import { collectionObjects, type getSourceRecord } from "../data/collection";
import type { SourceKind, SourceTopic } from "../data/collection-model";
import { messages } from "../i18n/catalogues";
import { type Locale, publicRecordPath, publicSectionPath } from "../i18n/routes";
import Layout from "../layouts/Layout.astro";

interface Props { locale: Locale; record: NonNullable<ReturnType<typeof getSourceRecord>>; }
const { locale, record } = Astro.props;
const { source, outgoing, incoming, relatedObjects, depictingObjects, images, claims, editorials } = record;
const t = messages(locale);
const kindLabels: Record<SourceKind, string> = {
  webpage: t.sourceKindWebpage, publication: t.sourceKindPublication, photograph: t.sourceKindPhotograph,
  artwork: t.sourceKindArtwork, correspondence: t.sourceKindCorrespondence, audiovisual: t.sourceKindAudiovisual,
  other: t.sourceKindOther,
};
const topicLabels: Record<SourceTopic, string> = {
  displacement: t.sourceTopicDisplacement, restitution: t.sourceTopicRestitution,
  "museum-practices": t.sourceTopicMuseumPractices, representations: t.sourceTopicRepresentations,
};
const objectTitle = (id: string) => collectionObjects.find((object) => object.id === id)?.name ?? id;
const relationshipLabel: Record<string, string> = locale === "en"
  ? { reproduces: "Reproduces", discusses: "Discusses", is_part_of: "Part of", reproducedBy: "Reproduced by", discussedBy: "Discussed by", includes: "Includes" }
  : { reproduces: "Reproduce", discusses: "Analiza", is_part_of: "Forma parte de", reproducedBy: "Reproducido por", discussedBy: "Analizado por", includes: "Incluye" };
const incomingLabel = (type: string) => type === "reproduces" ? relationshipLabel.reproducedBy : type === "discusses" ? relationshipLabel.discussedBy : relationshipLabel.includes;
const referenceURL = (value: string) => {
  const candidate = value.match(/https?:\/\/\S+$/u)?.[0] ?? value;
  try {
    const url = new URL(candidate);
    return ["http:", "https:"].includes(url.protocol) ? url.href : null;
  } catch {
    return null;
  }
};
const sourceURL = referenceURL(source.reference);
---
<Layout locale={locale} page="collection" publicRecord={{ section: "sources", id: source.id }} title={`${source.title} — MoSA`} description={source.title}>
  <article class="container section source-detail" data-record-id={source.id}>
    <CollectionNav locale={locale} active="sources" />
    <p><a href={publicSectionPath("sources", locale)}>{locale === "en" ? "← Documents and images" : "← Documentos e imágenes"}</a></p>
    <p class="eyebrow">{kindLabels[source.kind]}</p>
    <h1>{source.title}</h1>
    <dl class="source-metadata">
      <div><dt>{locale === "en" ? "Author or institution" : "Autoría o institución"}</dt><dd>{source.author ?? t.undocumented}</dd></div>
      <div><dt>{locale === "en" ? "Reference" : "Referencia"}</dt><dd>{sourceURL ? <a href={sourceURL} rel="noreferrer">{source.reference}</a> : source.reference}</dd></div>
      {source.date && <div><dt>{locale === "en" ? "Date" : "Fecha"}</dt><dd>{source.date}</dd></div>}
      <div><dt>{locale === "en" ? "Language" : "Idioma"}</dt><dd lang={source.language}>{source.language}</dd></div>
    </dl>
    {source.topics && <ul class="source-topic-list">{source.topics.map((topic) => <li>{topicLabels[topic]}</li>)}</ul>}
    {images.length > 0 && <section aria-labelledby="source-images"><h2 id="source-images">{locale === "en" ? "Images and other representations" : "Imágenes y otras representaciones"}</h2><div class="image-gallery">{images.map(({ image, asset }) => <figure><Image src={asset} alt={image.alt} lang={source.language} widths={[480, 960, 1440]} sizes="(max-width: 60rem) 100vw, 50vw" /><figcaption class="small">{image.caption && <span lang={source.language}>{image.caption}</span>}{image.credit && <span>{locale === "en" ? "Credit" : "Crédito"}: {image.credit}</span>}{image.rights && <span>{locale === "en" ? "Rights" : "Derechos"}: {image.rights}</span>}{image.originalUrl && <a href={image.originalUrl} rel="noreferrer">{locale === "en" ? "Original image" : "Imagen original"}</a>}</figcaption></figure>)}</div></section>}
    {depictingObjects.length > 0 && <section><h2>{locale === "en" ? "Depicts" : "Representa"}</h2><ul>{depictingObjects.map(({ id }) => <li><a href={publicRecordPath("objects", id, locale)}>{objectTitle(id)}</a></li>)}</ul></section>}
    {relatedObjects.length > 0 && <section><h2>{locale === "en" ? "Related objects" : "Objetos relacionados"}</h2><ul>{relatedObjects.map((id) => <li><a href={publicRecordPath("objects", id, locale)}>{objectTitle(id)}</a></li>)}</ul></section>}
    {(outgoing.length > 0 || incoming.length > 0) && <section><h2>{locale === "en" ? "Related sources" : "Fuentes relacionadas"}</h2><ul class="source-relations">{outgoing.map(({ source: target, type, locator }) => <li><span>{relationshipLabel[type]}: </span><a href={publicRecordPath("sources", target.id, locale)}>{target.title}</a>{locator && <span> — {locator}</span>}</li>)}{incoming.map(({ source: from, type, locator }) => <li><span>{incomingLabel(type)}: </span><a href={publicRecordPath("sources", from.id, locale)}>{from.title}</a>{locator && <span> — {locator}</span>}</li>)}</ul></section>}
    {claims.length > 0 && (
      <section>
        <h2>{locale === "en" ? "Attributed object claims" : "Afirmaciones atribuidas sobre objetos"}</h2>
        <ul class="source-claims">
          {claims.map(({ claim }) => (
            <li>
              <ClaimStatement claim={claim} language={source.language} locale={locale} />
              <a href={publicRecordPath("objects", claim.objectId, locale)}>
                {locale === "en" ? "View object" : "Ver objeto"}: {objectTitle(claim.objectId)}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    {editorials.length > 0 && <section><h2>{locale === "en" ? "Editorials examining this source" : "Editoriales que examinan esta fuente"}</h2><ul>{editorials.map((entry) => <li><a href={publicRecordPath("editorials", entry.id, locale)}>{entry.title}</a></li>)}</ul></section>}
  </article>
</Layout>
