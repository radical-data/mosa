---
import PageIntro from "../components/PageIntro.astro";
import PageLink from "../components/PageLink.astro";
import VisitMap from "../components/VisitMap.astro";
import { getCopy } from "../content/content";
import { collectionMapLocations, collectionMapUnresolved } from "../data/site";
import type { Locale } from "../i18n/routes";
import Layout from "../layouts/Layout.astro";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = getCopy("visit", locale);
---
<Layout locale={locale} page="visit" title={copy.title} description={copy.description}>
  <PageIntro title={copy.passage03} image="rongorongo"><p>{copy.passage04}</p></PageIntro>
  <section class="container section visit-distribution" aria-labelledby="visit-map-title">
    <div class="visit-map-heading">
      <div>
        <h2 class="eyebrow" id="visit-map-title">{copy.mapTitle}</h2>
        <p class="visit-statement">{copy.mapLead}</p>
        <p class="small muted">{copy.mapExplanation}</p>
      </div>
      <p class="visit-count"><strong>{collectionMapLocations.reduce((total, entry) => total + entry.objects.length, 0)}</strong><span>{copy.objectCountLabel}</span></p>
    </div>
    <VisitMap locale={locale} locations={collectionMapLocations} unresolved={collectionMapUnresolved} copy={copy} />
  </section>
  <section class="container section connect-strip"><div><h2 class="eyebrow">{copy.passage09}</h2><p>{copy.passage10}</p></div><PageLink class="button" page="events" locale={locale}>{copy.passage16}<span aria-hidden="true">↗</span></PageLink></section>
</Layout>
