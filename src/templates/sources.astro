---
import { Image } from "astro:assets";
import CollectionNav from "../components/CollectionNav.astro";
import { sourceRecords } from "../data/collection";
import type { SourceKind, SourceTopic } from "../data/collection-model";
import { messages } from "../i18n/catalogues";
import { type Locale, publicRecordPath } from "../i18n/routes";
import Layout from "../layouts/Layout.astro";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = messages(locale);
const heading = t.documentsImages;
const kindLabels: Record<SourceKind, string> = {
  webpage: t.sourceKindWebpage,
  publication: t.sourceKindPublication,
  photograph: t.sourceKindPhotograph,
  artwork: t.sourceKindArtwork,
  correspondence: t.sourceKindCorrespondence,
  audiovisual: t.sourceKindAudiovisual,
  other: t.sourceKindOther,
};
const topicLabels: Record<SourceTopic, string> = {
  displacement: t.sourceTopicDisplacement,
  restitution: t.sourceTopicRestitution,
  "museum-practices": t.sourceTopicMuseumPractices,
  representations: t.sourceTopicRepresentations,
};
const kinds = Object.entries(kindLabels) as [SourceKind, string][];
const topics = Object.entries(topicLabels) as [SourceTopic, string][];
---
<Layout locale={locale} page="collection" publicIndex="sources" title={`${heading} — MoSA`} description={heading}>
  <section class="container section source-index" data-source-index data-locale={locale}>
    <CollectionNav locale={locale} active="sources" />
    <header class="section-heading"><div><p class="eyebrow">MoSA</p><h1>{heading}</h1></div></header>
    <div class="source-filters" hidden>
      <label>{t.sourceSearch}<input type="search" data-source-search placeholder={t.sourceSearch} /></label>
      <label>{t.sourceKind}<select data-source-kind><option value="">{t.allSourceKinds}</option>{kinds.map(([id, label]) => <option value={id}>{label}</option>)}</select></label>
      <label>{t.sourceTopic}<select data-source-topic><option value="">{t.allSourceTopics}</option>{topics.map(([id, label]) => <option value={id}>{label}</option>)}</select></label>
    </div>
    <p class="small muted" role="status" aria-live="polite" data-source-count>{sourceRecords.length} {t.sourceCount}</p>
    <div class="source-list" data-source-results>
      {sourceRecords.map((source) => <article class="source-card" data-source-card data-search={source.searchText} data-kind={source.kind} data-topics={(source.topics ?? []).join(" ")}>
        {source.imagesWithAssets[0] && <Image src={source.imagesWithAssets[0].asset} alt={source.imagesWithAssets[0].image.alt} widths={[360, 720]} sizes="(max-width: 48rem) 100vw, 30vw" />}
        <div>
          <p class="eyebrow">{kindLabels[source.kind]}</p>
          <h2><a href={publicRecordPath("sources", source.id, locale)}>{source.title}</a></h2>
          <p>{source.author ?? t.undocumented}</p>
          <p class="small muted">{source.reference}{source.date ? ` · ${source.date}` : ""}</p>
          {(source.topics?.length ?? 0) > 0 && <ul class="source-topic-list">{source.topics?.map((topic) => <li>{topicLabels[topic]}</li>)}</ul>}
        </div>
      </article>)}
    </div>
    <p class="empty-state" hidden data-source-empty>{t.noMatches}</p>
  </section>
</Layout>
<script>
  import "../i18n/source-index-client";
</script>
