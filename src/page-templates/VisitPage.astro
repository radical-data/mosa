---
import PageLink from "../components/PageLink.astro";
import VisitMap from "../components/VisitMap.astro";
import { getCopy } from "../content/content";
import { visitHolders } from "../data/site";
import type { Locale } from "../i18n/routes";
import Layout from "../layouts/Layout.astro";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = getCopy("visit", locale);
---
<Layout locale={locale} page="visit" title={copy.title} description={copy.description}>
  <section class="container visit-distribution" aria-labelledby="visit-title">
    <header class="visit-intro">
      <h1 id="visit-title">{copy.passage03}</h1>
      <p class="visit-invitation">{copy.passage04}</p>
      <p class="small muted">{copy.mapExplanation}</p>
    </header>
    <VisitMap locale={locale} destinations={visitHolders} copy={copy} />
  </section>
  <section class="container section connect-strip"><div><h2 class="eyebrow">{copy.passage09}</h2><p>{copy.passage10}</p></div><PageLink class="button" page="events" locale={locale}>{copy.passage16}<span aria-hidden="true">↗</span></PageLink></section>
</Layout>

<style>

.visit-distribution {
  padding-top: 3.5rem;
  padding-bottom: 2rem;
}
.visit-intro {
  max-width: 58rem;
  margin-bottom: 2rem;
}
.visit-intro h1 {
  margin-bottom: 1.5rem;
}
.visit-invitation {
  font-size: clamp(1.25rem, 2.2vw, 1.75rem);
  margin-bottom: 1rem;
}
@media (max-width: 520px) {
  .visit-distribution {
    padding-top: 2rem;
  }
}
</style>
