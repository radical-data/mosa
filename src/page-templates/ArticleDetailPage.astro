---
import ArticleBody from "../components/ArticleBody.astro";
import { type ArticleEntry, collectionObjects, collectionSources } from "../data/collection";
import type { RecordReference } from "../data/collection-model";
import { type Locale, pagePath, publicRecordPath, publicSectionPath } from "../i18n/routes";
import Layout from "../layouts/Layout.astro";

interface Props { locale: Locale; article: ArticleEntry; }
const { locale, article } = Astro.props;
const subjectTitle = (subject: RecordReference) =>
  subject.type === "object"
    ? collectionObjects.find((object) => object.id === subject.id)?.name ?? subject.id
    : collectionSources.find((source) => source.id === subject.id)?.title ?? subject.id;
---
<Layout locale={locale} page="resources" publicRecord={{ section: "articles", id: article.id }} title={`${article.title} — MoSA`} description={article.summary ?? article.title}>
  <article class="container section article-detail">
    <nav aria-label={locale === "en" ? "Breadcrumb" : "Ruta de navegación"} class="article-breadcrumb">
      <a href={pagePath("resources", locale)}>{locale === "en" ? "Resources" : "Recursos"}</a>
      <span aria-hidden="true"> / </span>
      <a href={publicSectionPath("articles", locale)}>{locale === "en" ? "Articles" : "Artículos"}</a>
    </nav>
    <h1 lang={article.language}>{article.title}</h1>
    {article.summary && <p lang={article.language}>{article.summary}</p>}
    {article.subjects && article.subjects.length > 0 && <section><h2>{locale === "en" ? "Subjects" : "Temas"}</h2><ul>{article.subjects.map((subject) => <li><a href={publicRecordPath(subject.type === "object" ? "objects" : "sources", subject.id, locale)}>{subjectTitle(subject)}</a></li>)}</ul></section>}
    <ArticleBody article={article} locale={locale} showTitle={false} />
  </article>
</Layout>
