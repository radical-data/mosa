---
import { Image } from "astro:assets";
import CollectionNav from "../components/CollectionNav.astro";
import PageIntro from "../components/PageIntro.astro";
import { getCopy } from "../content/content";
import { claimValueLanguage } from "../data/collection-record";
import { collectionRecords } from "../data/site";
import { messages } from "../i18n/catalogues";
import { referenceCount } from "../i18n/messages";
import { type Locale, pagePath } from "../i18n/routes";
import Layout from "../layouts/Layout.astro";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = getCopy("collection", locale);
const collection = collectionRecords;
const t = messages(locale);
---
<Layout locale={locale} page="collection" title={copy.title} description={copy.description}>
  <PageIntro title={copy.passage03} image="mahute"><p><Fragment set:html={copy.passage06} /></p><a class="text-link" href="#more-information">{copy.passage17}</a></PageIntro>
  <section class="container section collection-section" aria-label={t.collectionExplore} data-locale={locale}>
    <CollectionNav locale={locale} active="objects" />
    <div class="collection-controls" hidden>
      <label for="collection-search">{t.collectionSearch}</label>
      <input id="collection-search" type="search" placeholder={t.collectionSearch} />
    </div>
    <p class="small muted" id="collection-count" role="status" aria-live="polite">{referenceCount(locale, { count: collection.length })}</p>
    {collection.length === 0 && <p>{t.collectionPending}</p>}
    <div class="collection-grid public-collection" id="collection-results">{collection.map((item) => <article class="collection-card" data-record-id={item.object.id} data-search-exact={item.searchExact} data-search-foldable={item.searchFoldable}>
      {item.images[0] && <Image src={item.images[0].asset} alt={item.images[0].image.alt} lang={item.images[0].source.language} widths={[360, 720]} sizes="(max-width: 48rem) 100vw, 33vw" />}
      <div class="collection-caption">
        <h2><a href={`${pagePath("collection", locale)}${item.object.id}/`}>{item.object.name}</a></h2>
        {[...new Map(item.claims.filter(({ claim }) => claim.predicate === "held_by").map((entry) => [`${entry.claim.language ?? entry.source.language}\u0000${entry.claim.value}`, entry])).values()].map(({ claim, source }) => <p>{t.reportedHolder} <span lang={claimValueLanguage(claim, source.language)}>{claim.value}</span></p>)}
        {item.claims.filter(({ claim }) => claim.predicate === "catalogue_number").map(({ claim, source }) => <p>{t.catalogueNumber} <span lang={claimValueLanguage(claim, source.language)}>{claim.value}</span></p>)}
      </div>
    </article>)}</div>
    <div class="empty-state" hidden><h2><Fragment set:html={t.noMatches} /></h2><p><Fragment set:html={t.noMatchesHelp} /></p><button class="button" type="button" id="reset-filters">{t.clearFilters}</button></div>
    <noscript><p><Fragment set:html={t.enableCollectionScript} /></p></noscript>
  </section>
  <section class="container section" id="more-information"><h2 class="eyebrow"><Fragment set:html={copy.passage12} /></h2><div class="info-grid"><article class="info-card coral"><h3><Fragment set:html={copy.passage13} /></h3><p><Fragment set:html={copy.passage14} /></p></article><article class="info-card"><h3><Fragment set:html={copy.passage15} /></h3><p><Fragment set:html={copy.passage16} /></p></article></div></section>
</Layout>

<script>
  import "../i18n/collection-client";
</script>

<style>

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}
.info-card {
  background: #000;
  color: #fff;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 290px;
}
.info-card.coral {
  background: var(--coral);
  color: #000;
}
.info-card h3 {
  margin-bottom: 1rem;
}
.info-card p {
  font-size: 0.9rem;
}
.info-card:target {
  outline: 3px solid var(--coral);
  outline-offset: 5px;
}
.info-card.coral:target {
  outline-color: #000;
}
.collection-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1.5rem;
  margin-bottom: 2rem;
}
.collection-grid {
  --collection-columns: 4;
  --collection-column-gap: 1rem;
  display: grid;
  grid-template-columns: repeat(var(--collection-columns), minmax(0, 1fr));
  align-items: start;
  gap: 3.5rem var(--collection-column-gap);
  margin-top: 2rem;
}
.collection-grid[data-masonry] {
  display: block;
  position: relative;
}
.collection-caption {
  margin-top: 1.25rem;
}
.collection-caption h2 {
  font-size: 1.05rem;
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin-bottom: 0.5rem;
}
.collection-caption p {
  font-size: 0.75rem;
  margin: 0.2rem 0;
}
.collection-caption span {
  font-weight: 500;
}
.public-collection .collection-card {
  border-top: 1px solid currentColor;
  padding-top: 1rem;
}
.public-collection .collection-caption {
  padding: 0;
}
.public-collection .collection-caption p {
  overflow-wrap: anywhere;
}
.public-collection .collection-caption a {
  display: inline-block;
  margin-right: 0.5rem;
  text-decoration: underline;
}
.collection-grid[data-masonry] .collection-card {
  position: absolute;
  width: calc((100% - (var(--collection-columns) - 1) * var(--collection-column-gap)) / var(--collection-columns));
}

@media (max-width: 1100px) {
  .info-card {
    padding: 1.5rem;
  }
}
@media (max-width: 800px) {
  .collection-grid {
    --collection-columns: 2;
    row-gap: 2.5rem;
  }
}
@media (max-width: 520px) {
  .info-grid {
    grid-template-columns: 1fr;
  }
  .info-card {
    min-height: 240px;
  }
  .collection-caption h2 {
    font-size: 0.95rem;
  }
  .collection-caption p {
    font-size: 0.7rem;
  }
}
</style>
