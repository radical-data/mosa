---
import ArticlePreview from "../components/ArticlePreview.astro";
import { articlePublications, collectionObjects, collectionSources } from "../data/collection";
import type { RecordReference } from "../data/collection-model";
import { messages } from "../i18n/catalogues";
import { type Locale, pagePath, publicRecordPath } from "../i18n/routes";
import Layout from "../layouts/Layout.astro";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = messages(locale);
const subjectTitle = (subject: RecordReference) =>
  subject.type === "object"
    ? collectionObjects.find((object) => object.id === subject.id)?.name ?? subject.id
    : collectionSources.find((source) => source.id === subject.id)?.title ?? subject.id;
---
<Layout locale={locale} page="resources" publicIndex="articles" title={`${t.articleIndexTitle} — MoSA`} description={t.articleIndexDescription}>
  <section class="container section article-index">
    <p><a href={pagePath("resources", locale)}>← {t.resources}</a></p>
    <header class="section-heading"><div><p class="eyebrow">MoSA</p><h1>{t.articleIndexTitle}</h1><p>{t.articleIndexDescription}</p></div></header>
    <div class="article-index-list">
      {articlePublications.map((article) => <ArticlePreview article={article} locale={locale} headingLevel="h2">
        {article.subjects && <ul>{article.subjects.map((subject) => <li><a href={publicRecordPath(subject.type === "object" ? "objects" : "sources", subject.id, locale)}>{subjectTitle(subject)}</a></li>)}</ul>}
      </ArticlePreview>)}
    </div>
  </section>
</Layout>

<style>

.article-index-list {
  border-top: 1px solid var(--rule);
}
.article-index-list > :global(.article-preview) {
  display: grid;
  grid-template-columns: minmax(9rem, 0.8fr) 2fr;
  gap: 1.5rem;
  padding-block: 1.5rem;
  border-bottom: 1px solid var(--rule);
}
.article-index-list :global(h2) {
  font-size: clamp(1.35rem, 2.2vw, 2rem);
  margin-block: 0.35rem;
}
.article-index-list > :global(.article-preview) {
  grid-template-columns: 1fr;
}
</style>
