---
import { Font } from "astro:assets";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { githubURL, instagramURL } from "../data/site";
import { messages } from "../i18n/catalogues";
import { absolutePageURL, type Locale, localeIds, locales, type PageId, type PublicSection, pagePath, publicRecordPath, publicSectionPath, type ResourceId, resourcePath, siteURL } from "../i18n/routes";
import "../styles/global.css";

interface Props { title: string; description: string; locale: Locale; page?: PageId; resource?: ResourceId; collectionItemId?: string; publicRecord?: { section: PublicSection; id: string }; publicIndex?: PublicSection; }
const { title, description, locale, page, resource, collectionItemId, publicRecord, publicIndex } = Astro.props;
const pathFor = (id: Locale) => resource
  ? resourcePath(resource, id)
  : publicRecord
  ? publicRecordPath(publicRecord.section, publicRecord.id, id)
  : publicIndex
    ? publicSectionPath(publicIndex, id)
    : collectionItemId
      ? `${pagePath("collection", id)}${collectionItemId}/`
      : page ? pagePath(page, id) : undefined;
const pageURL = (id: Locale) => {
  const path = pathFor(id);
  return path ? new URL(path, siteURL).href : page ? absolutePageURL(page, id) : undefined;
};
const canonicalURL = pageURL(locale);
const isPublicRoute = Boolean(page || publicRecord || publicIndex);
const organisationSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Museum of Stolen Artefacts",
  url: siteURL,
  sameAs: [githubURL, instagramURL],
});
---
<!doctype html>
<html lang={locales[locale].language}>
  <head>
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {!isPublicRoute && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    {isPublicRoute && <>
      {localeIds.map((id) => <link rel="alternate" hreflang={locales[id].hreflang} href={pageURL(id)} />)}
      <link rel="alternate" hreflang="x-default" href={pageURL("es")} />
      <link rel="sitemap" href="/sitemap-index.xml" />
    </>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-general-sans" preload={[{ weight: 500, style: "normal" }]} />
    <Font cssVariable="--font-noto-sans-eng" />
    {isPublicRoute && <script type="application/ld+json" set:html={organisationSchema} is:inline />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{messages(locale).skip}</a>
    <Header locale={locale} page={page} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
