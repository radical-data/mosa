---
import { Image } from "astro:assets";
import EditorialArticle from "../../../components/EditorialArticle.astro";
import { collectionObjects, getObjectRecord } from "../../../data/collection";
import { predicateLabel } from "../../../i18n/predicates";
import { type Locale, localeIds, pagePath } from "../../../i18n/routes";
import Layout from "../../../layouts/Layout.astro";

interface Props {
  locale: Locale;
  objectId: string;
}

export function getStaticPaths() {
  return collectionObjects.flatMap((object) =>
    localeIds.map((locale) => ({
      params: {
        lang: locale,
        collection: locale === "es" ? "coleccion" : "collection",
        id: object.id,
      },
      props: { locale, objectId: object.id },
    })),
  );
}

const copy = {
  en: {
    back: "Collection",
    foregrounded: "Foregrounded perspectives",
    images: "Images",
    editorials: "MoSA editorials",
    sources: "Source accounts",
    recorded: "Recorded in",
    author: "Source author",
    credit: "Credit",
    rights: "Rights",
    original: "Original image",
    missing: "Object not found",
  },
  es: {
    back: "Colección",
    foregrounded: "Perspectivas destacadas",
    images: "Imágenes",
    editorials: "Editoriales de MoSA",
    sources: "Relatos de las fuentes",
    recorded: "Registrado en",
    author: "Autoría de la fuente",
    credit: "Crédito",
    rights: "Derechos",
    original: "Imagen original",
    missing: "No se encontró el objeto",
  },
} as const;
const { locale, objectId } = Astro.props;
const record = getObjectRecord(objectId);
if (!record) throw new Error(`Missing collection object ${objectId}`);
const t = copy[locale];
const referenceURL = (value: string) => {
  const candidate = value.match(/https?:\/\/\S+$/u)?.[0] ?? value;
  try {
    const url = new URL(candidate);
    return ["http:", "https:"].includes(url.protocol) ? url.href : null;
  } catch {
    return null;
  }
};
---

<Layout
  locale={locale}
  page={record ? "collection" : undefined}
  collectionItemId={record?.object.id}
  title={`${record?.object.name ?? "Collection"} — MoSA`}
  description={record?.object.name ?? "Collection"}
>
  {!record ? (
    <section class="container section"><h1>{t.missing}</h1></section>
  ) : (
    <article class="container section dossier" data-record-id={record.object.id}>
      <p><a href={pagePath("collection", locale)}>← {t.back}</a></p>
      <h1>{record.object.name}</h1>

      {record.foregroundedClaims.length > 0 && (
        <section>
          <h2>{t.foregrounded}</h2>
          <div class="claims">
            {record.foregroundedClaims.map(({ claim, source }) => (
              <article class="claim">
                <p lang={source.language === "und" ? undefined : source.language}>
                  <strong>{predicateLabel(claim.predicate, locale)}:</strong> {claim.value}
                </p>
                <p class="small muted">{t.recorded}: {source.reference}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      {record.images.length > 0 && (
        <section>
          <h2>{t.images}</h2>
          <div class="image-gallery">
            {record.images.map(({ image, source, asset }) => (
              <figure>
                <Image
                  src={asset}
                  alt={image.alt}
                  widths={[480, 960, 1440]}
                  sizes="(max-width: 60rem) 100vw, 50vw"
                />
                <figcaption class="small">
                  {image.caption && <span>{image.caption}</span>}
                  {image.credit && <span>{t.credit}: {image.credit}</span>}
                  {image.rights && <span>{t.rights}: {image.rights}</span>}
                  {image.originalUrl && <a href={image.originalUrl} rel="noreferrer">{t.original}</a>}
                  <span>{t.recorded}: {source.reference}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      {record.editorials.length > 0 && (
        <section>
          <h2>{t.editorials}</h2>
          {record.editorials
            .sort((a, b) => Number(b.language.startsWith(locale)) - Number(a.language.startsWith(locale)))
            .map((editorial) => <EditorialArticle editorial={editorial} locale={locale} />)}
        </section>
      )}

      <section>
        <h2>{t.sources}</h2>
        <div class="source-accounts">
          {record.sources.map((source) => {
            const url = referenceURL(source.reference);
            return (
              <article class="source-account">
                <h3>{url ? <a href={url} rel="noreferrer">{source.reference}</a> : source.reference}</h3>
                {source.author && <p class="small muted">{t.author}: {source.author}</p>}
                {source.claims.length > 0 && (
                  <ul>
                    {source.claims.map((claim) => (
                      <li lang={source.language === "und" ? undefined : source.language}>
                        <strong>{predicateLabel(claim.predicate, locale)}:</strong> {claim.value}
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            );
          })}
        </div>
      </section>
    </article>
  )}
</Layout>

<style>
  .dossier { max-width: 72rem; }
  .dossier > section { margin-block-start: clamp(3rem, 8vw, 6rem); }
  .claims, .source-accounts, .image-gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 1rem; }
  .claim, .source-account { border: 1px solid currentColor; padding: 1rem; overflow-wrap: anywhere; }
  .source-account h3 { font-size: 1rem; }
  .source-account ul { padding-inline-start: 1.25rem; }
  figure { margin: 0; }
  figure :global(img) { width: 100%; height: auto; }
  figcaption { display: grid; gap: .25rem; margin-block-start: .5rem; }
  .editorial-article + .editorial-article { margin-block-start: 4rem; }
  :global(.editorial-prose) { max-width: 48rem; }
  :global(.editorial-prose p) { line-height: 1.7; }
</style>
