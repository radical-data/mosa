---
import type { Locale } from "../../../i18n/routes";
import ArticlesPage from "../../../page-templates/ArticlesPage.astro";
import SourcesPage from "../../../page-templates/SourcesPage.astro";

export function getStaticPaths() {
  return [
    { params: { lang: "en", section: "sources" }, props: { locale: "en", section: "sources" } },
    { params: { lang: "es", section: "fuentes" }, props: { locale: "es", section: "sources" } },
    { params: { lang: "en", section: "articles" }, props: { locale: "en", section: "articles" } },
    { params: { lang: "es", section: "articulos" }, props: { locale: "es", section: "articles" } },
  ];
}

interface Props { locale: Locale; section: "sources" | "articles"; }
const { locale, section } = Astro.props;
---
{section === "sources" ? <SourcesPage locale={locale} /> : <ArticlesPage locale={locale} />}
