---
import type { VisitHolder } from "../data/visit-holders";
import { type Locale, publicRecordPath } from "../i18n/routes";

interface Copy {
  mapReset: string; mapUnavailable: string; mapSelectPrompt: string;
  locationListTitle: string; locationUnknown: string; visitInformation: string; showOnMap: string;
  precisionSite: string; precisionLocality: string; precisionRegion: string; precisionCountry: string;
  statusReported: string; statusHistorical: string; statusUncertain: string; statusUnknown: string;
  objectLabel: string; objectsLabel: string; evidenceLabel: string; coordinateSource: string;
  relatedObjects: string; noMappedPlaces: string;
}
interface Props { locale: Locale; destinations: VisitHolder[]; copy: Copy; }
const { locale, destinations, copy } = Astro.props;
const objectPath = (id: string) => publicRecordPath("objects", id, locale);
const sourcePath = (id: string) => publicRecordPath("sources", id, locale);
const precisionLabels = { site: copy.precisionSite, locality: copy.precisionLocality, region: copy.precisionRegion, country: copy.precisionCountry };
const statusLabels = { reported: copy.statusReported, historical: copy.statusHistorical, uncertain: copy.statusUncertain, unknown: copy.statusUnknown };
const objectCount = (count: number) => `${count} ${count === 1 ? copy.objectLabel : copy.objectsLabel}`;
const points = destinations.flatMap(({ holder }) => holder.location ? [{
  id: holder.id, name: holder.name,
  longitude: holder.location.longitude, latitude: holder.location.latitude,
}] : []);
---
<div class="visit-explorer" data-points={JSON.stringify(points)}>
  <div class="visit-map-layout">
    <div class="visit-map-column">
      <div class="visit-map-toolbar" hidden><button type="button" class="button" data-map-reset>{copy.mapReset}</button></div>
      <section class="visit-map" data-map aria-label={copy.mapSelectPrompt}>
        <p class="visit-map-fallback">{copy.mapUnavailable}</p>
      </section>
    </div>
    <aside class="visit-map-details" data-map-details aria-live="polite" aria-label={copy.mapSelectPrompt}>
      <p class="muted">{copy.mapSelectPrompt}</p>
    </aside>
  </div>
  <section class="visit-location-list" aria-labelledby="visit-location-list-title">
    <h3 id="visit-location-list-title">{copy.locationListTitle}</h3>
    {points.length === 0 && <p>{copy.noMappedPlaces}</p>}
    {destinations.map(({ holder, objects }) => <article class="visit-place" data-holder-id={holder.id}>
      <details>
        <summary><span>{holder.name}</span>{" "}<span class="small muted">{holder.location?.name ?? copy.locationUnknown}</span></summary>
        {holder.location && <button class="button visit-show-on-map" type="button" data-show-holder={holder.id} hidden>{copy.showOnMap}</button>}
        <div class="visit-holder-content">
          <p class="small muted">{holder.location ? `${holder.location.name} · ${precisionLabels[holder.location.precision]}` : copy.locationUnknown}</p>
          <p class="visit-holder-links">
            {holder.visitUrl && <a href={holder.visitUrl} target="_blank" rel="noreferrer">{copy.visitInformation} ↗</a>}
            {holder.location && <a href={holder.location.reference} target="_blank" rel="noreferrer">{copy.coordinateSource} ↗</a>}
          </p>
          <details class="visit-holder-objects">
            <summary>{copy.relatedObjects} · {objectCount(objects.length)}</summary>
            <ul>{objects.map(({ object, status, claims, note }) => <li>
              <a href={objectPath(object.id)}>{object.name}</a>
              <span class="visit-location-meta">{statusLabels[status]}</span>
              {note && <p lang={note.language}>{note.text}</p>}
              <p class="small visit-evidence">{copy.evidenceLabel}: {[...new Map(claims.map(({ source }) => [source.id, source])).values()].map((source, index) => <Fragment>{index > 0 && " · "}<a href={sourcePath(source.id)}>{source.title}</a></Fragment>)}</p>
            </li>)}</ul>
          </details>
        </div>
      </details>
    </article>)}
  </section>
</div>

<script>
  import * as maplibregl from "maplibre-gl";
  import maplibreWorkerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url";
  import "maplibre-gl/dist/maplibre-gl.css";

  type Point = { id: string; name: string; longitude: number; latitude: number };
  const root = document.querySelector<HTMLElement>(".visit-explorer");
  const mapElement = root?.querySelector<HTMLElement>("[data-map]");
  const panel = root?.querySelector<HTMLElement>("[data-map-details]");
  if (root && mapElement && panel) {
    try {
      const points = JSON.parse(root.dataset.points ?? "[]") as Point[];
      const rows = new Map([...root.querySelectorAll<HTMLElement>("[data-holder-id]")].map((row) => [row.dataset.holderId, row]));
      const markers = new Map<string, HTMLButtonElement>();
      maplibregl.setWorkerUrl(maplibreWorkerUrl);
      const map = new maplibregl.Map({
        container: mapElement,
        style: {
          version: 8,
          sources: {
            land: { type: "geojson", data: "/map/natural-earth-land-110m.geojson", attribution: "Natural Earth" },
          },
          layers: [
            { id: "background", type: "background", paint: { "background-color": "#e9e7e1" } },
            { id: "land", type: "fill", source: "land", paint: { "fill-color": "#f9f8f4", "fill-outline-color": "#d0cec7" } },
          ],
        },
        center: [-110, -10], zoom: 0.6, minZoom: 0.6, maxZoom: 12,
        dragRotate: false, touchPitch: false, pitchWithRotate: false,
        attributionControl: { compact: true }, cooperativeGestures: true,
      });
      map.touchZoomRotate.disableRotation();
      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");
      const showHolder = (point: Point) => {
        const content = rows.get(point.id)?.querySelector(".visit-holder-content");
        if (!content) return;
        const heading = document.createElement("h3");
        heading.textContent = point.name;
        panel.replaceChildren(heading, content.cloneNode(true));
        for (const [id, button] of markers) {
          button.setAttribute("aria-pressed", String(id === point.id));
        }
      };
      const fitAll = (duration: number) => {
        if (!points.length) return;
        if (points.length === 1) {
          map.easeTo({ center: [points[0].longitude, points[0].latitude], zoom: 2, duration });
          return;
        }
        const bounds = new maplibregl.LngLatBounds();
        for (const point of points) bounds.extend([point.longitude, point.latitude]);
        map.fitBounds(bounds, { padding: 36, maxZoom: 4, duration });
      };
      root.querySelector("[data-map-reset]")?.addEventListener("click", () => fitAll(600));
      map.on("load", () => {
        mapElement.querySelector(".visit-map-fallback")?.remove();
        root.querySelector(".visit-map-toolbar")?.removeAttribute("hidden");
        for (const point of points) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "visit-map-marker";
          button.setAttribute("aria-label", point.name);
          button.setAttribute("aria-pressed", "false");
          button.title = point.name;
          button.addEventListener("click", () => showHolder(point));
          new maplibregl.Marker({ element: button, anchor: "center" })
            .setLngLat([point.longitude, point.latitude]).addTo(map);
          markers.set(point.id, button);
          const listButton = rows.get(point.id)?.querySelector<HTMLButtonElement>("[data-show-holder]");
          if (listButton) {
            listButton.hidden = false;
            listButton.addEventListener("click", () => {
              showHolder(point);
              map.easeTo({ center: [point.longitude, point.latitude], zoom: Math.max(map.getZoom(), 3) });
              mapElement.scrollIntoView({ block: "center", behavior: "smooth" });
              button.focus({ preventScroll: true });
            });
          }
        }
        fitAll(0);
      });
    } catch (error) {
      console.error("Could not initialise the Visit map", error);
    }
  }
</script>
