---
import { mailchimpSignupAction } from "../data/site";
import { messages } from "../i18n/catalogues";
import type { Locale } from "../i18n/routes";

interface Props {
  locale: Locale;
  placement: "contact" | "footer";
}

const { locale, placement } = Astro.props;
const t = messages(locale);
const titleId = `newsletter-title-${placement}`;
const emailId = `newsletter-email-${placement}`;
const noteId = `newsletter-note-${placement}`;
---
<section
  id={placement === "contact" ? "newsletter" : undefined}
  class:list={["newsletter", `newsletter-${placement}`, placement === "footer" && "container"]}
  aria-labelledby={titleId}
>
  <div class="newsletter-copy">
    <h2 id={titleId}>{t.newsletterTitle}</h2>
    <p>{t.newsletterDescription}</p>
  </div>
  <form class="newsletter-form" action={mailchimpSignupAction} method="post">
    <label for={emailId}>{t.newsletterEmail}</label>
    <div class="newsletter-field">
      <input id={emailId} name="EMAIL" type="email" autocomplete="email" required aria-describedby={noteId} />
      <button class="button" type="submit" name="subscribe">{t.newsletterSubmit}</button>
    </div>
    <div class="newsletter-trap" aria-hidden="true">
      <input type="text" name="b_3484234c1c5960682945b6be0_712b203609" tabindex="-1" value="" autocomplete="off" />
    </div>
    <p class="newsletter-note" id={noteId}>
      {t.newsletterPrivacy} <a href="https://www.intuit.com/privacy/statement/">{t.newsletterPrivacyLink}</a>.
    </p>
  </form>
</section>

<style>
  .newsletter {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 1fr);
    gap: 2rem 4rem;
  }

  .newsletter h2 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.5rem, 2.4vw, 2.35rem);
  }

  .newsletter-copy p {
    max-width: 42rem;
    font-size: 0.95rem;
  }

  .newsletter-form {
    min-width: 0;
  }

  .newsletter-form > label {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .newsletter-field {
    display: flex;
  }

  .newsletter-field input {
    min-width: 0;
    flex: 1;
    padding: 0.7rem 0.8rem;
    border: 1px solid #000;
    border-radius: 0;
    background: #fff;
  }

  .newsletter-field .button {
    flex-shrink: 0;
  }

  .newsletter-note {
    margin-top: 0.65rem;
    font-size: 0.7rem;
  }

  .newsletter-note a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .newsletter-trap {
    position: absolute;
    left: -5000px;
  }

  .newsletter-contact {
    grid-template-columns: 1fr;
    margin-block: 3rem 1rem;
    padding-block: 2rem;
    border-block: 1px solid var(--rule);
  }

  .newsletter-footer {
    padding-block: 2.5rem;
    border-block: 1px solid #666;
  }

  .newsletter-footer .newsletter-field input {
    border-color: #fff;
    background: #000;
    color: #fff;
  }

  .newsletter-footer .newsletter-field .button {
    border-color: #fff;
    background: #fff;
    color: #000;
  }

  .newsletter-footer .newsletter-field .button:hover {
    border-color: var(--coral);
    background: var(--coral);
  }

  @media (max-width: 800px) {
    .newsletter {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .newsletter-field {
      flex-direction: column;
      gap: 0.5rem;
    }

    .newsletter-field .button {
      width: 100%;
    }
  }
</style>
