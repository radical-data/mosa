---
import type { Claim } from "../data/collection-model";
import { claimValueLanguage } from "../data/collection-record";
import { predicateLabel } from "../i18n/predicates";
import type { Locale } from "../i18n/routes";

interface Props {
  claim: Claim;
  language: string;
  locale: Locale;
}

const { claim, language: sourceLanguage, locale } = Astro.props;
const valueLang = claimValueLanguage(claim, sourceLanguage);
const locatorLang = sourceLanguage === "und" ? undefined : sourceLanguage;
---

<p>
  <strong>{predicateLabel(claim.predicate, locale)}:</strong>{" "}
  <span lang={valueLang}>{claim.value}</span>
</p>
{claim.locator && (
  <p class="small muted">
    {locale === "en" ? "Passage" : "Pasaje"}: <span lang={locatorLang}>{claim.locator}</span>
  </p>
)}
