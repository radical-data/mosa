---
import type { Locale } from "../../i18n/routes";
import "../../styles/resource-guides.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const en = locale === "en";
const labels = en
  ? {
      kicker: "People and relations",
      title: "A restitution process is held by many hands",
      lead: "Restitution begins with a relationship between those who offer and those who receive. Either side may initiate a process. The participants and route depend on each case.",
      giver: "Giver / current holder",
      giverItems: ["Museum or collection", "Religious congregation", "Government or university", "Private collector"],
      process: "Restitution process",
      processSub: "dialogue · decision · preparation · return",
      centre: "The person, ancestor or entity at the centre",
      receiver: "Receiver / related community",
      receiverItems: ["Rapa Nui people", "Clan or family", "Traditional authorities", "Representative body"],
      intermediaries: "Intervening actors",
      mediators: "Facilitation and mediation",
      mediatorItems: ["Diplomatic services", "Ministries and heritage agencies", "International organisations", "NGOs and intermediaries"],
      expertise: "Technical and political roles",
      expertiseItems: ["Curators and conservators", "Researchers and laboratories", "Legal specialists", "Customs, health and decision bodies"],
      contexts: "Conditions around the process",
      contextItems: ["Legal frameworks and policy", "Consent and community validation", "Institutional decisions", "Research and documentation", "Transport and logistics", "Cultural and spiritual responsibilities"],
      routes: "Possible routes",
      routeItems: ["Museum → Rapa Nui community", "Cultural institution → MAPSE → community", "Collector → Rapa Nui family", "University → Rapa Nui organisation"],
      note: "Positions can overlap. A holder may also mediate its own process; communities can include people with different responsibilities and views. The map describes possible relationships, not a required sequence.",
      summary: "The map links a giver or current holder and a receiver or related community through a restitution process. Facilitators, technical experts and political actors may intervene. Legal, cultural, logistical and community conditions shape the route.",
    }
  : {
      kicker: "Personas y relaciones",
      title: "Un proceso de restitución se sostiene entre muchas manos",
      lead: "La restitución comienza con una relación entre quien entrega y quien recibe. Cualquiera de las partes puede activar el proceso. Los participantes y la vía dependen de cada caso.",
      giver: "Quien entrega / tenedor actual",
      giverItems: ["Museo o colección", "Congregación religiosa", "Gobierno o universidad", "Coleccionista privado"],
      process: "Proceso de restitución",
      processSub: "diálogo · decisión · preparación · retorno",
      centre: "La persona, el ancestro o la entidad en el centro",
      receiver: "Quien recibe / comunidad vinculada",
      receiverItems: ["Pueblo rapa nui", "Clan o familia", "Autoridades tradicionales", "Entidad representativa"],
      intermediaries: "Actores que intervienen",
      mediators: "Acompañamiento y mediación",
      mediatorItems: ["Servicios diplomáticos", "Ministerios y entidades patrimoniales", "Organismos internacionales", "ONG e intermediarios"],
      expertise: "Funciones técnicas y políticas",
      expertiseItems: ["Curadores y conservadores", "Investigadores y laboratorios", "Especialistas jurídicos", "Aduanas, salud y órganos decisores"],
      contexts: "Condiciones del proceso",
      contextItems: ["Marcos jurídicos y políticas", "Consentimiento y validación comunitaria", "Decisiones institucionales", "Investigación y documentación", "Traslado y logística", "Responsabilidades culturales y espirituales"],
      routes: "Vías posibles",
      routeItems: ["Museo → comunidad rapa nui", "Institución cultural → MAPSE → comunidad", "Coleccionista → familia rapa nui", "Universidad → organización rapa nui"],
      note: "Las posiciones pueden superponerse. Un tenedor puede mediar su propio proceso; una comunidad puede incluir personas con responsabilidades y perspectivas distintas. El mapa muestra relaciones posibles, no una secuencia obligatoria.",
      summary: "El mapa vincula a quien entrega o mantiene la tenencia actual con quien recibe o una comunidad relacionada, mediante un proceso de restitución. Pueden intervenir facilitadores, especialistas y actores políticos. Las condiciones jurídicas, culturales, logísticas y comunitarias influyen en cada vía.",
    };
---

<section class="actor-map-guide" lang={en ? "en-GB" : "es-CL"} aria-labelledby="actor-map-heading">
  <header class="actor-map-heading">
    <p class="resource-guide-kicker">{labels.kicker}</p>
    <h1>{en ? "Participant map" : "Mapeo de actores"}</h1>
    <h2 id="actor-map-heading">{labels.title}</h2>
    <p>{labels.lead}</p>
  </header>

  <figure class="actor-map" aria-labelledby="actor-map-caption" aria-describedby="actor-map-summary">
    <figcaption id="actor-map-caption">{labels.process} · {en ? "A map of relationships" : "Mapa de relaciones"}</figcaption>
    <p id="actor-map-summary" class="sr-only">{labels.summary}</p>

    <section class="actor-parties" aria-label={en ? "Main participants" : "Participantes principales"}>
      <section class="actor-party actor-giver" aria-labelledby="actor-giver-title">
        <p class="actor-role">01 / {en ? "Origin" : "Origen"}</p>
        <h3 id="actor-giver-title">{labels.giver}</h3>
        <ul>{labels.giverItems.map((item) => <li>{item}</li>)}</ul>
      </section>

      <div class="actor-process">
        <span class="actor-process-orbit" aria-hidden="true"></span>
        <p class="actor-process-label">{labels.process}</p>
        <p class="actor-process-steps">{labels.processSub}</p>
        <div class="actor-centre">{labels.centre}</div>
      </div>

      <section class="actor-party actor-receiver" aria-labelledby="actor-receiver-title">
        <p class="actor-role">02 / {en ? "Relation" : "Vínculo"}</p>
        <h3 id="actor-receiver-title">{labels.receiver}</h3>
        <ul>{labels.receiverItems.map((item) => <li>{item}</li>)}</ul>
      </section>
    </section>

    <section class="actor-interveners" aria-labelledby="actor-interveners-title">
      <header><span class="actor-rule-label">03 /</span><h3 id="actor-interveners-title">{labels.intermediaries}</h3></header>
      <div class="actor-intervener-grid">
        <section class="actor-intervener">
          <h4>{labels.mediators}</h4><ul>{labels.mediatorItems.map((item) => <li>{item}</li>)}</ul>
        </section>
        <section class="actor-intervener">
          <h4>{labels.expertise}</h4><ul>{labels.expertiseItems.map((item) => <li>{item}</li>)}</ul>
        </section>
      </div>
    </section>

    <div class="actor-bottom-grid">
      <section class="actor-context" aria-labelledby="actor-context-title">
        <p class="actor-rule-label">04 /</p><h3 id="actor-context-title">{labels.contexts}</h3>
        <ul>{labels.contextItems.map((item) => <li>{item}</li>)}</ul>
      </section>
      <section class="actor-routes" aria-labelledby="actor-routes-title">
        <p class="actor-rule-label">05 /</p><h3 id="actor-routes-title">{labels.routes}</h3>
        <ol>{labels.routeItems.map((item) => <li>{item}</li>)}</ol>
      </section>
    </div>
    <p class="actor-map-note">{labels.note}</p>
  </figure>
</section>
