---
import { organisations } from "../../data/resources";
import type { Locale } from "../../i18n/routes";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const en = locale === "en";
---

<section class="directory-guide" lang={en ? "en-GB" : "es-CL"} aria-labelledby="directory-guide-title">
  <header class="directory-masthead">
    <div class="directory-title-block">
      <p class="resource-guide-kicker">{en ? "A field guide to connections" : "Una guía para encontrar vínculos"}</p>
      <h1 id="directory-guide-title">{en ? "Directory of organisations" : "Directorio de organizaciones"}</h1>
    </div>
    <div class="directory-lead-block">
      <p class="directory-lead">{en
        ? "Organisations and initiatives working with restitution, memory, language and Indigenous data sovereignty."
        : "Organizaciones e iniciativas que trabajan en restitución, memoria, lenguas y soberanía indígena de datos."}</p>
      <p>{en
        ? "This directory is a starting point for learning and making connections. Inclusion does not imply endorsement. Check each organisation’s current remit and contact details before relying on them."
        : "Este directorio es un punto de partida para conocer iniciativas y establecer vínculos. La inclusión no implica respaldo. Revisa el trabajo y los datos de contacto vigentes de cada organización antes de usarlos."}</p>
    </div>
  </header>

  <div class="directory-table-wrap">
    <table class="directory-table">
      <caption class="sr-only">{en ? "Organisations and initiatives" : "Organizaciones e iniciativas"}</caption>
      <thead><tr>
        <th scope="col">{en ? "Organisation" : "Organización"}</th>
        <th scope="col">{en ? "Focus" : "Ámbito"}</th>
        <th scope="col">{en ? "Explore" : "Conocer"}</th>
      </tr></thead>
      <tbody>{organisations.map((organisation, index) => <tr>
        <th scope="row">
          <span class="directory-index">{String(index + 1).padStart(2, "0")}</span>
          <span class="directory-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="directory-org-name">{organisation.name}</span>
        </th>
        <td data-label={en ? "Focus" : "Ámbito"}>
          <p>{organisation.description[locale]}</p>
          <ul class="directory-tags" aria-label={en ? "Topics" : "Temas"}>
            {organisation.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </td>
        <td data-label={en ? "Explore" : "Conocer"}><a class="directory-link" href={organisation.url} target="_blank" rel="noreferrer">
          {en ? "Visit website" : "Visitar sitio web"}<span aria-hidden="true">↗</span>
          <span class="sr-only"> — {organisation.name}</span>
        </a></td>
      </tr>)}</tbody>
    </table>
  </div>
  <p class="directory-footnote">{en ? "A changing landscape · Last reviewed by each organisation" : "Un panorama en movimiento · Consulta la información vigente de cada organización"}</p>
</section>

<style>
  .resource-guide-kicker {
    margin: 0 0 1rem;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .directory-guide {
    width: calc(100vw - var(--gutter, 5.5rem) * 2);
    margin: 3rem calc(50% - 50vw + var(--gutter, 5.5rem)) 4rem;
  }
  .directory-masthead {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(16rem, 0.8fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: end;
    padding-bottom: clamp(2rem, 5vw, 4.5rem);
  }
  .directory-title-block h1 {
    max-width: 12ch;
    font-size: clamp(3.8rem, 8vw, 8rem);
    font-weight: 400;
    letter-spacing: -0.07em;
    line-height: 0.82;
  }
  .directory-lead-block {
    padding-bottom: 0.4rem;
  }
  .directory-lead-block p {
    max-width: 45ch;
    font-size: 0.96rem;
  }
  .directory-lead-block .directory-lead {
    margin-bottom: 1.2rem;
    font-size: clamp(1.3rem, 2.1vw, 2rem);
    line-height: 1.15;
  }
  .directory-table-wrap {
    border-top: 1px solid #000;
  }
  .directory-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .directory-table thead th {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid #000;
    color: #595959;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-align: left;
    text-transform: uppercase;
  }
  .directory-table thead th:first-child {
    width: 28%;
    padding-left: 0;
  }
  .directory-table thead th:nth-child(2) { width: 54%; }
  .directory-table thead th:last-child { width: 18%; }
  .directory-table tbody tr { border-bottom: 1px solid #bdbdbd; }
  .directory-table tbody th,
  .directory-table tbody td {
    padding: 1.4rem 1rem;
    vertical-align: top;
    text-align: left;
  }
  .directory-table tbody th {
    padding-left: 0;
    font-weight: 400;
  }
  .directory-org-name {
    display: block;
    max-width: 23ch;
    font-size: clamp(1.15rem, 1.8vw, 1.65rem);
    font-weight: 500;
    line-height: 1.1;
  }
  .directory-index {
    display: inline-block;
    margin-right: 0.7rem;
    color: #777;
    font-size: 0.7rem;
    vertical-align: top;
  }
  .directory-mark {
    position: relative;
    display: inline-flex;
    width: 3.5rem;
    height: 2.1rem;
    gap: 0.22rem;
    align-items: center;
    justify-content: center;
    margin: 0 0.75rem 0.65rem 0;
    background: #ffded9;
    vertical-align: middle;
  }
  .directory-table tbody tr:nth-child(3n + 2) .directory-mark { background: #e8e4ff; }
  .directory-table tbody tr:nth-child(3n) .directory-mark { background: #e4ebd9; }
  .directory-mark i {
    display: block;
    width: 0.36rem;
    height: 0.9rem;
    border: 1px solid #000;
    border-radius: 50%;
    transform: rotate(24deg);
  }
  .directory-mark i:nth-child(2) {
    height: 1.35rem;
    transform: rotate(-14deg);
  }
  .directory-table tbody td p {
    max-width: 65ch;
    margin: 0 0 0.75rem;
  }
  .directory-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .directory-tags li {
    padding: 0.25rem 0.5rem;
    border: 1px solid #bdbdbd;
    border-radius: 99px;
    font-size: 0.68rem;
    line-height: 1.25;
  }
  .directory-link {
    display: inline-flex;
    gap: 0.5rem;
    align-items: baseline;
    font-size: 0.87rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .directory-footnote {
    margin-top: 1rem;
    color: #595959;
    font-size: 0.75rem;
  }

  @media (max-width: 850px) {
    .directory-masthead {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .directory-title-block h1 {
      max-width: 10ch;
      font-size: clamp(3.6rem, 14vw, 7rem);
    }
  }
  @media (max-width: 620px) {
    .directory-guide {
      width: calc(100vw - 2.5rem);
      margin-inline: calc(50% - 50vw + 1.25rem);
    }
    .directory-table,
    .directory-table tbody,
    .directory-table tbody tr,
    .directory-table tbody th,
    .directory-table tbody td {
      display: block;
      width: 100%;
    }
    .directory-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .directory-table tbody tr { padding-block: 1rem; }
    .directory-table tbody th,
    .directory-table tbody td { padding: 0.55rem 0; }
    .directory-table tbody th { border: 0; }
    .directory-org-name {
      max-width: none;
      font-size: 1.35rem;
    }
    .directory-table tbody td::before {
      display: block;
      margin-bottom: 0.35rem;
      color: #595959;
      content: attr(data-label);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
  }
</style>
