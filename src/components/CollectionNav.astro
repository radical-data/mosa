---
import { messages } from "../i18n/catalogues";
import { type Locale, pagePath, publicSectionPath } from "../i18n/routes";

interface Props { locale: Locale; active: "objects" | "sources"; }
const { locale, active } = Astro.props;
const t = messages(locale);
---
<nav class="collection-subnav" aria-label={t.collectionSubnavigation}>
  <a href={pagePath("collection", locale)}>{locale === "en" ? "Everything" : "Todo"}</a>
  <a href={`${pagePath("collection", locale)}?scope=objects`} aria-current={active === "objects" ? "page" : undefined}>
    {locale === "en" ? "Objects" : "Objetos"}
  </a>
  <a href={publicSectionPath("sources", locale)} aria-current={active === "sources" ? "page" : undefined}>
    {t.documentsImages}
  </a>
</nav>

<style>
  .collection-subnav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--coral);
    text-decoration-thickness: 0.2rem;
    text-underline-offset: 0.3rem;
  }

  .collection-subnav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-block: 0 3rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9rem;
  }
</style>
