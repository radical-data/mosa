---
import { Image } from "astro:assets";
import type { CollectionRecord } from "../data/collection";
import { messages } from "../i18n/catalogues";
import { formatNumber } from "../i18n/format";
import { type Locale, publicRecordPath } from "../i18n/routes";

interface Props { record: CollectionRecord; locale: Locale; headingLevel?: "h2" | "h3"; searchable?: boolean; }
const { record, locale, headingLevel: Heading = "h3", searchable = false } = Astro.props;
const t = messages(locale);
const image = record.images[0];
const href = publicRecordPath("objects", record.object.id, locale);
const sourceCount = `${formatNumber(record.sources.length, locale)} ${record.sources.length === 1 ? t.sourceSingular : t.sourceCount}`;
---
<article class="object-card" data-record-id={record.object.id} data-catalogue-card={searchable || undefined} data-has-image={Boolean(image)} data-search-exact={searchable ? record.searchExact : undefined} data-search-foldable={searchable ? record.searchFoldable : undefined}>
  <a class="object-card-media" href={href} tabindex="-1" aria-label={image ? undefined : `${record.object.name}: ${t.noImage}`}>
    {image ? <Image src={image.asset} alt={image.image.alt} lang={image.source.language === "und" ? undefined : image.source.language} widths={[240, 360, 640]} sizes="(max-width: 40rem) 90vw, (max-width: 65rem) 44vw, 22vw" loading="lazy" /> : <span class="sr-only">{t.noImage}</span>}
  </a>
  <div class="object-card-copy">
    <Heading><a href={href}>{record.object.name}</a></Heading>
    <p class="object-card-count">{sourceCount}</p>
    {image && <p class="object-card-source"><a href={publicRecordPath("sources", image.source.id, locale)}>{t.imageSource}</a></p>}
  </div>
</article>

<style>
  .object-card { min-width: 0; }
  .object-card-media { display: grid; place-items: center; aspect-ratio: 1; padding: 1rem; background: #fff; overflow: hidden; }
  .object-card[data-has-image="false"] .object-card-media { background: #f3f2ef; }
  .object-card-media :global(img) { width: 100%; height: 100%; min-height: 0; object-fit: contain; }
  .object-card-copy { padding-block: 1rem; }
  h2, h3 { font-size: 1.1rem; font-weight: 500; line-height: 1.3; letter-spacing: -.02em; margin: 0 0 .5rem; overflow-wrap: anywhere; }
  h2 a, h3 a { text-decoration: none; }
  h2 a:hover, h3 a:hover { text-decoration: underline; text-decoration-color: var(--coral); text-decoration-thickness: 3px; }
  p { margin: .3rem 0; font-size: .78rem; }
  .object-card-count { color: var(--muted); }
  .object-card-source { overflow-wrap: anywhere; }
  .object-card-source a { text-decoration: underline; }
  :global(.catalogue-grid.is-list) .object-card { display: grid; grid-template-columns: 6rem minmax(0,1fr); gap: 1.25rem; padding-block: 1rem; border-top: 1px solid var(--rule); }
  :global(.catalogue-grid.is-list) .object-card-media { padding: .4rem; font-size: .65rem; }
  :global(.catalogue-grid.is-list) .object-card-copy { padding: 0; }
  :global(.catalogue-grid.is-list) h3 { font-size: 1.2rem; }
</style>
