{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://museumofstolenartefacts.org/schema/source.schema.json",
  "title": "MoSA collection source",
  "type": "object",
  "additionalProperties": false,
  "required": ["author", "reference", "language", "claims", "images"],
  "properties": {
    "author": { "type": ["string", "null"], "minLength": 1 },
    "reference": { "type": "string", "minLength": 1 },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "objectIds": {
      "description": "Objects directly documented by this source and not already linked through a claim or image in the same source.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "notes": {
      "description": "MoSA research notes about interpreting or transcribing this source. Retained as metadata, not rendered on the website or attributed to the source author.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "language"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "objectId", "predicate", "value"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "objectId": { "$ref": "#/$defs/id" },
          "predicate": {
            "enum": [
              "has_name",
              "classified_as",
              "described_as",
              "made_of",
              "made_at",
              "made_during",
              "found_at",
              "held_by",
              "located_at",
              "catalogue_number"
            ]
          },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objectId", "file", "alt"],
        "properties": {
          "objectId": { "$ref": "#/$defs/id" },
          "file": { "type": "string", "minLength": 1 },
          "alt": { "type": "string" },
          "originalUrl": { "type": "string", "format": "uri" },
          "caption": { "type": "string", "minLength": 1 },
          "credit": { "type": "string", "minLength": 1 },
          "rights": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
