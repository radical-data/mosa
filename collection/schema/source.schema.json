{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://museumofstolenartefacts.org/schema/source.schema.json",
  "title": "MoSA collection source",
  "type": "object",
  "additionalProperties": false,
  "required": ["author", "reference", "language", "claims", "images"],
  "properties": {
    "author": { "type": ["string", "null"], "minLength": 1 },
    "reference": { "type": "string", "minLength": 1 },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "objectIds": {
      "description": "Objects directly documented by this source and not already linked through a claim or image in the same source.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "notes": {
      "description": "MoSA research notes about interpreting or transcribing this source. Retained as metadata, not rendered on the website or attributed to the source author.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "language"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        }
      }
    },
    "captures": {
      "description": "Local or archived captures documenting the source. Local files are stored under source-files/<source-id>/.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capturedAt", "method"],
        "anyOf": [{ "required": ["file"] }, { "required": ["archiveUrl"] }],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.(?:html|pdf|jpg|jpeg|png|webp|avif|tif|tiff)$"
          },
          "originalUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "archiveUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://web\\.archive\\.org/web/[0-9]{14}(?:id_|if_)?/https?://.+$"
          },
          "capturedAt": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
              }
            ]
          },
          "method": { "enum": ["singlefile", "download", "supplied-file", "browser-pdf"] },
          "note": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "objectId", "predicate", "value"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "objectId": { "$ref": "#/$defs/id" },
          "holderId": { "$ref": "#/$defs/id" },
          "predicate": {
            "enum": [
              "has_name",
              "classified_as",
              "described_as",
              "made_of",
              "made_at",
              "made_during",
              "found_at",
              "held_by",
              "located_at",
              "catalogue_number"
            ]
          },
          "value": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "required": ["holderId"] },
            "then": { "properties": { "predicate": { "const": "held_by" } } }
          }
        ]
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objectId", "file", "alt"],
        "properties": {
          "objectId": { "$ref": "#/$defs/id" },
          "file": { "type": "string", "minLength": 1 },
          "alt": { "type": "string" },
          "originalUrl": { "type": "string", "format": "uri" },
          "caption": { "type": "string", "minLength": 1 },
          "credit": { "type": "string", "minLength": 1 },
          "rights": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
