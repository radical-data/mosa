{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://museumofstolenartefacts.org/schema/object.schema.json",
  "title": "MoSA collection object",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "foregroundedClaims"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "foregroundedClaims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claimReference" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "claimReference": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
