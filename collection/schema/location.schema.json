{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://museumofstolenartefacts.org/schema/location.schema.json",
  "title": "MoSA object location assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "claimReferences", "reviewedAt"],
  "properties": {
    "status": { "enum": ["reported", "historical", "uncertain", "unknown"] },
    "claimReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "holderId": { "$ref": "#/$defs/id" },
    "location": { "$ref": "#/$defs/geocodedLocation" },
    "reviewedAt": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "language"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "language": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "unknown" } }, "required": ["status"] },
      "then": { "not": { "required": ["location"] } }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["historical", "uncertain"] } },
        "required": ["status"]
      },
      "then": { "required": ["note"] }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "geocodedLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "precision", "longitude", "latitude", "reference"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "precision": { "enum": ["site", "locality", "region", "country"] },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "reference": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    }
  }
}
